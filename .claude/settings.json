    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\nodejs\\node.exe",
            "args": [
              "C:\\Users\\Ian\\OneDrive\\Documents\\claude_projects\\.claude\\worktree-create.mjs"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\nodejs\\node.exe",
            "args": [
              "C:\\Users\\Ian\\OneDrive\\Documents\\claude_projects\\.claude\\worktree-remove.mjs"
