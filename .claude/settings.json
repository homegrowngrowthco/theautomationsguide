{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\nodejs\\node.exe",
            "args": [
              "C:\\Users\\Ian\\OneDrive\\Documents\\claude_projects\\.claude\\claim-op.mjs"
            ],
            "timeout": 15,
            "statusMessage": "Reserving this session's op number"
          }
