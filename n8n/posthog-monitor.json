{
  "name": "PostHog Liveness Monitor — TAG",
  "nodes": [
    {
      "parameters": {},
      "id": "tag00004-0000-0000-0000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 200]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 14 * * *" }]
        }
      },
      "id": "tag00004-0000-0000-0000-000000000002",
      "name": "Daily 9am ET",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 400]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "posthogHost", "value": "https://us.posthog.com", "type": "string" },
            { "id": "c2", "name": "posthogProjectId", "value": "REPLACE_WITH_POSTHOG_PROJECT_ID", "type": "string" },
            { "id": "c3", "name": "slackWebhookUrl", "value": "REPLACE_WITH_SLACK_WEBHOOK_URL", "type": "string" },
            { "id": "c4", "name": "siteUrl", "value": "https://theautomationsguide.com", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "tag00004-0000-0000-0000-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Build the PostHog query: pageviews in the last 24h.\nconst config = $input.first().json;\nconst since = new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString();\nreturn [{ json: { ...config, since } }];"
      },
      "id": "tag00004-0000-0000-0000-000000000004",
      "name": "Compute Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.posthogHost }}/api/projects/{{ $json.posthogProjectId }}/events/?event=$pageview&after={{ $json.since }}&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": { "response": { "neverError": true, "fullResponse": true } }
        }
      },
      "id": "tag00004-0000-0000-0000-000000000005",
      "name": "Query PostHog",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_POSTHOG_CREDENTIAL_ID",
          "name": "PostHog Personal API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Decide whether to alert.\n// We alert if:\n//   - PostHog returned a non-2xx (auth/config issue), OR\n//   - the events array is empty (no pageviews in 24h = tracking is broken or site is dead)\nconst config = $('Config').first().json;\nconst resp = $input.first().json;\nconst statusCode = resp.statusCode;\nconst body = resp.body || {};\n\nlet alertReason = null;\nlet eventsCount = null;\n\nif (statusCode !== 200) {\n  alertReason = `PostHog API returned status ${statusCode}. Check the Personal API Key + project ID. Body preview: ${JSON.stringify(body).substring(0, 300)}`;\n} else {\n  const results = Array.isArray(body.results) ? body.results : [];\n  eventsCount = results.length;\n  // The events endpoint returns a paginated list. Even one page result with limit=1 means activity exists.\n  // No results AND no `next` page = genuinely zero events in window.\n  if (eventsCount === 0 && !body.next) {\n    alertReason = `Zero $pageview events captured in the last 24h on PostHog. Either traffic is dead or tracking broke. Site: ${config.siteUrl}`;\n  }\n}\n\nreturn [{ json: { ...config, statusCode, eventsCount, alertReason, shouldAlert: !!alertReason } }];"
      },
      "id": "tag00004-0000-0000-0000-000000000006",
      "name": "Evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            { "id": "1", "leftValue": "={{ $json.shouldAlert }}", "rightValue": "={{ true }}", "operator": { "type": "boolean", "operation": "true" } }
          ]
        },
        "options": {}
      },
      "id": "tag00004-0000-0000-0000-000000000007",
      "name": "If Alert",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.slackWebhookUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ text: `🚨 *PostHog liveness check failed for theautomationsguide*\\n${$json.alertReason}\\n\\nSteps to investigate:\\n1. Open ${$json.siteUrl} in incognito and check browser DevTools network tab for posthog.com requests\\n2. Confirm the PostHog Project Settings → Project API Key matches what's set in src/components/Analytics.astro\\n3. Check PostHog → Activity → Live events for the project` }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "tag00004-0000-0000-0000-000000000008",
      "name": "Slack Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 200]
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Daily 9am ET":   { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config":         { "main": [[{ "node": "Compute Window", "type": "main", "index": 0 }]] },
    "Compute Window": { "main": [[{ "node": "Query PostHog", "type": "main", "index": 0 }]] },
    "Query PostHog":  { "main": [[{ "node": "Evaluate", "type": "main", "index": 0 }]] },
    "Evaluate":       { "main": [[{ "node": "If Alert", "type": "main", "index": 0 }]] },
    "If Alert":       { "main": [[{ "node": "Slack Alert", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "meta": { "templateCredsSetupCompleted": false },
  "pinData": {},
  "versionId": "1",
