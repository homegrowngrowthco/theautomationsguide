{
  "name": "Notion Publish Status — TAG (PR merge → Status: Published)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tag-pr-merged",
        "options": { "responseMode": "onReceived", "responseCode": 204 }
      },
      "id": "tag00005-0000-0000-0000-000000000001",
      "name": "GitHub Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "tag-pr-merged"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "topicsDatabaseId", "value": "62f34586-4f78-4b83-b2ac-105f500d059e", "type": "string" },
            { "id": "c2", "name": "slackWebhookUrl", "value": "REPLACE_WITH_SLACK_WEBHOOK_URL", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "tag00005-0000-0000-0000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// GitHub fires this webhook for many event types. Filter to:\n//   - pull_request.closed events\n//   - merged === true\n//   - base.ref === 'master' (don't update Notion for non-prod merges)\n//   - head.ref starts with 'content/' (only content engine PRs map to Notion topics)\nconst config = $('Config').first().json;\nconst payload = $('GitHub Webhook').first().json.body || {};\n\nconst action = payload.action;\nconst pr = payload.pull_request || {};\nconst merged = pr.merged === true;\nconst baseRef = pr.base?.ref;\nconst headRef = pr.head?.ref || '';\nconst prUrl = pr.html_url;\n\nconst eligible =\n  action === 'closed' &&\n  merged &&\n  baseRef === 'master' &&\n  headRef.startsWith('content/') &&\n  !!prUrl;\n\nif (!eligible) {\n  // Not our event — silently no-op so GitHub doesn't see a 5xx.\n  console.log(`Webhook skipped: action=${action} merged=${merged} baseRef=${baseRef} headRef=${headRef}`);\n  return [];\n}\n\nreturn [{ json: { ...config, prUrl, prTitle: pr.title, prNumber: pr.number, mergedAt: pr.merged_at } }];"
      },
      "id": "tag00005-0000-0000-0000-000000000003",
      "name": "Filter Eligible",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.notion.com/v1/databases/{{ $json.topicsDatabaseId }}/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Notion-Version", "value": "2022-06-28" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ filter: { property: 'PR URL', url: { equals: $json.prUrl } }, page_size: 1 }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "tag00005-0000-0000-0000-000000000004",
      "name": "Find Notion Topic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_NOTION_CREDENTIAL_ID",
          "name": "Notion Integration Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Pull the matched Notion page ID. If no match, abort gracefully — the PR\n// might be a non-engine content commit or the calendar entry was deleted.\nconst meta = $('Filter Eligible').first().json;\nconst response = $input.first().json;\nconst page = (response.results || [])[0];\n\nif (!page) {\n  console.log(`No Notion topic found with PR URL ${meta.prUrl}. Skipping status update.`);\n  return [];\n}\n\nreturn [{ json: { ...meta, topicPageId: page.id } }];"
      },
      "id": "tag00005-0000-0000-0000-000000000005",
      "name": "Resolve Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.notion.com/v1/pages/{{ $json.topicPageId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Notion-Version", "value": "2022-06-28" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ properties: { Status: { select: { name: 'Published' } } } }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "tag00005-0000-0000-0000-000000000006",
      "name": "Mark Published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_NOTION_CREDENTIAL_ID",
          "name": "Notion Integration Token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Resolve Page').first().json.slackWebhookUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ text: `📰 Notion topic marked Published\\n*PR #${$('Resolve Page').first().json.prNumber}:* ${$('Resolve Page').first().json.prTitle}\\nLive on https://theautomationsguide.com after Netlify finishes (~90s).` }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "tag00005-0000-0000-0000-000000000007",
      "name": "Slack Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300]
    }
  ],
  "connections": {
    "GitHub Webhook":   { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config":           { "main": [[{ "node": "Filter Eligible", "type": "main", "index": 0 }]] },
    "Filter Eligible":  { "main": [[{ "node": "Find Notion Topic", "type": "main", "index": 0 }]] },
    "Find Notion Topic":{ "main": [[{ "node": "Resolve Page", "type": "main", "index": 0 }]] },
    "Resolve Page":     { "main": [[{ "node": "Mark Published", "type": "main", "index": 0 }]] },
    "Mark Published":   { "main": [[{ "node": "Slack Notify", "type": "main", "index": 0 }]] }
  },
