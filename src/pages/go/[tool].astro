---
import { affiliateLinks, resolveDestination } from '../../data/affiliate-links';

export function getStaticPaths() {
  return Object.keys(affiliateLinks).map((tool) => ({ params: { tool } }));
}

const { tool } = Astro.params;
const link = affiliateLinks[tool!];
const destination = resolveDestination(tool!);

// If somehow this page renders without a valid tool, fail loudly at build time so we don't
// quietly publish a broken redirect.
if (!link || !destination) {
  throw new Error(`Unknown affiliate tool: ${tool}. Add it to src/data/affiliate-links.ts`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <title>Redirecting to {link.name}…</title>
    <meta http-equiv="refresh" content={`0;url=${destination.url}`} />
    <link rel="canonical" href={destination.url} />
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #0d1117;
        color: #e6edf3;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        padding: 1rem;
      }
      .redirect-card {
        max-width: 480px;
        text-align: center;
      }
      .redirect-card a {
        color: #2dd4bf;
      }
      .spinner {
        display: inline-block;
        width: 1.5rem;
        height: 1.5rem;
        border: 2px solid #30363d;
        border-top-color: #2dd4bf;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
        margin-bottom: 1rem;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
    </style>
  </head>
  <body>
    <div class="redirect-card">
      <div class="spinner" aria-hidden="true"></div>
      <p>Redirecting to <strong>{link.name}</strong>…</p>
      <p style="font-size:0.875rem;color:#7d8590;">
        If you're not redirected, <a href={destination.url}>click here</a>.
      </p>
    </div>

    <script define:vars={{ tool, name: link.name, url: destination.url, isAffiliate: destination.isAffiliate }}>
      try {
        if (typeof window !== 'undefined' && window.posthog) {
          window.posthog.capture('affiliate_click', {
            tool,
            tool_name: name,
            destination_url: url,
            is_affiliate_url: isAffiliate,
            referrer: document.referrer || null,
          });
        }
      } catch (e) {
        // Don't let analytics failures block the redirect
      }
      // Use replace so the /go/ page doesn't pollute browser history
      window.location.replace(url);
    </script>
  </body>
</html>
