---
import { affiliateLinks, resolveDestination } from '../../data/affiliate-links';

export function getStaticPaths() {
  return Object.keys(affiliateLinks).map((tool) => ({ params: { tool } }));
}

const { tool } = Astro.params;
const link = affiliateLinks[tool!];
const destination = resolveDestination(tool!);

// If somehow this page renders without a valid tool, fail loudly at build time so we don't
// quietly publish a broken redirect.
if (!link || !destination) {
  throw new Error(`Unknown affiliate tool: ${tool}. Add it to src/data/affiliate-links.ts`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <title>Redirecting to {link.name}…</title>
    <noscript><meta http-equiv="refresh" content={`0;url=${destination.url}`} /></noscript>
    <link rel="canonical" href={destination.url} />
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #fdfcf8;
        color: #262b32;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        padding: 1rem;
      }
      .redirect-card {
        max-width: 480px;
        text-align: center;
      }
      .redirect-card a {
        color: #14a890;
      }
      .spinner {
        display: inline-block;
        width: 1.5rem;
        height: 1.5rem;
        border: 2px solid #e5e1d4;
        border-top-color: #14a890;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
        margin-bottom: 1rem;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
    </style>
  </head>
  <body>
    <div class="redirect-card">
      <div class="spinner" aria-hidden="true"></div>
      <p>Redirecting to <strong>{link.name}</strong>…</p>
      <p style="font-size:0.875rem;color:#7d8590;">
        If you're not redirected, <a href={destination.url}>click here</a>.
      </p>
    </div>

    <script define:vars={{ tool, name: link.name, url: destination.url, isAffiliate: destination.isAffiliate }}>
      // Fire affiliate_click, THEN redirect. The old code called window.posthog.capture(),
      // but this standalone page never loads the PostHog SDK (it bypasses
      // BaseLayout/Analytics.astro), so window.posthog was always undefined and NO
      // affiliate_click event ever fired (confirmed: 0 in PostHog over 180 days). We POST
      // straight to PostHog ingest via sendBeacon, which survives the imminent navigation.
      (function () {
        // Public ingest key + host — same values shipped in Analytics.astro.
        var PH_KEY = 'phc_tfEQ3bUgg7uXppT2vXRqzPcnv9PiJWWWYjPGAV7Zaabv';
        var INGEST = 'https://us.i.posthog.com/e/';
        function go() { window.location.replace(url); }
        try {
          // Reuse the visitor's existing PostHog distinct_id (set by the SDK on the
          // referring page) so pageview -> affiliate_click stays one funnel. A cold
          // entry straight to /go/ gets a random id.
          var did = null;
          var m = document.cookie.match(new RegExp('ph_' + PH_KEY + '_posthog=([^;]+)'));
          if (m) { try { did = JSON.parse(decodeURIComponent(m[1])).distinct_id; } catch (e) {} }
          if (!did) did = 'anon_' + Math.random().toString(36).slice(2) + '_' + Date.now();
          var payload = {
            api_key: PH_KEY,
            event: 'affiliate_click',
            distinct_id: did,
            properties: {
              distinct_id: did,
              tool: tool,
              tool_name: name,
              destination_url: url,
              is_affiliate_url: isAffiliate,
              referrer: document.referrer || null,
              $current_url: window.location.href,
            },
          };
          var blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
          var sent = false;
          if (navigator.sendBeacon) { sent = navigator.sendBeacon(INGEST, blob); }
          if (!sent) {
            // Older browsers / beacon rejected: keepalive fetch so the POST outlives navigation.
            fetch(INGEST, { method: 'POST', body: JSON.stringify(payload), headers: { 'Content-Type': 'application/json' }, keepalive: true }).catch(function () {});
          }
        } catch (e) {
          // Never let analytics block the redirect.
        }
        go();
      })();
    </script>
  </body>
</html>
