---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ItemListSchema from '../components/ItemListSchema.astro';
import { getCollection } from 'astro:content';
import { classifySection } from '../lib/post-cards';

// "Reviews" = single-tool, hands-on write-ups (classifySection() returns
// 'Review' when a post's title contains "review"), as opposed to the
// head-to-head "X vs Y" content, which lives at /guides/tool-vs-tool/.
// This page used to filter by the `comparison` tag instead, which meant it
// actually showed the tool-vs-tool set (0 overlap with the homepage's
// "Reviews" teaser, which already used classifySection() correctly) - fixed
// so both agree on the same posts. See docs/SESSION_LOG.md Session 94.

const all = await getCollection('blog', ({ data }) => !data.draft);
const posts = all
  .filter((p) => classifySection(p) === 'Review')
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Tool Reviews: Hands-On RevOps & GTM Software Takes"
  description="Hands-on, single-tool reviews of RevOps and GTM automation software: what's good, what's missing, and whether it's worth the price."
>
  <div class="container--wide">
    <div class="page-header">
      <h1>Reviews</h1>
      <p>One tool at a time, used long enough to hit its limits, with the parts the vendor page leaves out.</p>
    </div>

    {posts.length > 0 ? (
      <div class="card-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <div style="text-align:center;padding:5rem 0;color:var(--text-muted);">
        <p style="font-size:1.125rem;">Reviews are on the way. <a href="/blog/">Browse all articles</a>.</p>
      </div>
    )}
  </div>
  <ItemListSchema name="Tool Reviews" items={posts.map((p) => ({ url: `/blog/${p.slug}/`, name: p.data.title }))} />
</BaseLayout>
