---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ItemListSchema from '../components/ItemListSchema.astro';
import PageHead from '../components/ui/PageHead.astro';
import Container from '../components/ui/Container.astro';
import { getCollection } from 'astro:content';
import { classifySection } from '../lib/post-cards';

// "Reviews" = single-tool write-ups (classifySection() returns
// 'Review' when a post's title contains "review"), as opposed to the
// head-to-head "X vs Y" content, which lives at /guides/tool-vs-tool/.
// This page used to filter by the `comparison` tag instead, which meant it
// actually showed the tool-vs-tool set (0 overlap with the homepage's
// "Reviews" teaser, which already used classifySection() correctly) - fixed
// so both agree on the same posts. See docs/SESSION_LOG.md Session 94.

const all = await getCollection('blog', ({ data }) => !data.draft);
const posts = all
  .filter((p) => classifySection(p) === 'Review')
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Tool Reviews: RevOps & GTM Software, One Tool at a Time"
  description="Single-tool reviews of RevOps and GTM automation software: what's good, what's missing, and what it costs, with the price read from the vendor's own page."
>
  <PageHead
    eyebrow={`Reviews · ${posts.length} articles`}
    title="Reviews"
    lede="One tool at a time: what it is good at, where it falls short, and what it costs, with the parts the vendor page leaves out."
  />
  <div class="listing-main"><Container size="wide">

    {posts.length > 0 ? (
      <div class="card-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <div class="empty-state">
        <p>Reviews are on the way. <a href="/blog/">Browse all articles</a>.</p>
      </div>
    )}
  </Container></div>
  <ItemListSchema name="Tool Reviews" items={posts.map((p) => ({ url: `/blog/${p.slug}/`, name: p.data.title }))} />
</BaseLayout>
