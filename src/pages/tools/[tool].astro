---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { tools, postMentionsTool } from '../../data/tools';
import ToolPricing from '../../components/ToolPricing.astro';
import PostCard from '../../components/PostCard.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Stat from '../../components/ui/Stat.astro';
import { resolveDestination } from '../../data/affiliate-links';
import { pricedRow, pricingReadDate, money } from '../../lib/pricing-index';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  return tools.map((tool) => {
    const posts = allPosts
      .filter((post) => postMentionsTool(tool, post))
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
    return { params: { tool: tool.slug }, props: { tool, posts } };
  });
}

const { tool, posts } = Astro.props;

// Meta description: what the tool IS, from its own blurb, not one boilerplate line
// for every hub (audit 2026-10-01 F7/R5: /tools/close/ had 1.7k impressions at
// position 5 and 0 clicks on the template line). Clipped to a SERP-sized snippet at
// a sentence or word boundary. Auto-register placeholder blurbs keep the old line.
const clipDescription = (text: string, max = 158): string => {
  const t = text.replace(/\s+/g, ' ').trim();
  if (t.length <= max) return t;
  const sentences = t.match(/[^.!?]+[.!?]+/g) || [];
  let out = '';
  for (const raw of sentences) { const s = raw.trim(); if ((out + s).length > max) break; out += s + ' '; }
  if (out.trim().length >= 80) return out.trim();
  const cut = t.slice(0, max - 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:]$/, '') + '…';
};
const placeholderBlurb = /featured in a comparison on The Automations Guide|first and best source/i.test(tool.blurb) || tool.blurb.length < 60;
const description = placeholderBlurb
  ? `Every article on The Automations Guide that covers ${tool.name}, plus where it fits in a RevOps and GTM stack.`
  : clipDescription(tool.blurb);
// Disclose next to the CTA only when it really is an affiliate link (pending and
// rejected programs send readers to the plain homepage).
const ctaIsAffiliate = resolveDestination(tool.slug)?.isAffiliate === true;

// The /go/ button is the hub's one action, so it is the primary whenever the
// program is live; `ctaPrimary` (a /tools/ grid emphasis flag) decides otherwise.
// Band stat (design program 2026-10): the entry price from the pricing index with
// its read date, only when the index has one. No row, no stat; never a guess.
const priced = pricedRow(tool.slug);
const entry = priced?.entryPaidPlan;
const entryAnnual = money(entry?.monthlyBilledAnnually, priced?.currency);
const entryMonthly = money(entry?.monthlyBilledMonthly, priced?.currency);
const readOn = new Date(`${pricingReadDate}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const priceStat = entryAnnual || entryMonthly
  ? {
      value: `${entryAnnual ?? entryMonthly}/mo`,
      label: `entry paid plan${entry?.name ? ` (${entry.name})` : ''}, billed ${entryAnnual ? 'annually' : 'monthly'}`,
      source: `Vendor pricing page, read ${readOn}`,
    }
  : null;

// Optional SERP overrides (tool.seo, see tools.ts). The price-led description reads
// the same index row as the band stat and compares like with like: the top plan is
// quoted only on the entry plan's billing basis. No priced row = blurb description.
const pageTitle = tool.seo?.title ?? `${tool.name}: guides, reviews & alternatives`;
const billing = entryAnnual ? 'monthlyBilledAnnually' : 'monthlyBilledMonthly';
const topPlan = priced?.highestPublishedPlan;
const topPrice = money(topPlan?.[billing], priced?.currency);
const perUnit = priced?.pricingUnit === 'per seat' ? ' per user' : '';
const priceSentence = entryAnnual || entryMonthly
  ? `${tool.seo?.name ?? tool.name} starts at ${entryAnnual ?? entryMonthly}${perUnit}/mo billed ${entryAnnual ? 'annually' : 'monthly'}` +
    `${entry?.name ? ` (${entry.name})` : ''}` +
    `${topPrice && topPrice !== (entryAnnual ?? entryMonthly) ? ` and tops out at ${topPrice}${topPlan?.name ? ` (${topPlan.name})` : ''}` : ''}.`
  : null;
const metaDescription = tool.seo?.descriptionTail && priceSentence
  ? clipDescription(`${priceSentence} ${tool.seo.descriptionTail}`)
  : description;

const faqSchema =
  tool.faqs && tool.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: tool.faqs.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }
    : null;

// SoftwareApplication entity for the tool (audit S-2): reinforces the tool as a
// named entity in the graph and links our coverage of it. Only fields we can
// state accurately from the registry — no fabricated ratings or prices.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: tool.category,
  operatingSystem: 'Web',
  description: tool.blurb,
  url: `https://theautomationsguide.com/tools/${tool.slug}/`,
  ...(tool.badgeFree ? { offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' } } : {}),
};
---

<BaseLayout title={pageTitle} description={metaDescription}>
  <PageHead eyebrow={tool.category} title={tool.name} lede={tool.blurb} class="hub-band">
    <span slot="media" class="hub-logo">
      {tool.logo ? <img src={tool.logo} alt={`${tool.name} logo`} width="56" height="56" decoding="async" /> : <span>{tool.name.slice(0, 1)}</span>}
    </span>
    <div class="hub-row">
      <div class="tool-hub-actions">
        <Button
          href={`/go/${tool.slug}/`}
          variant={tool.ctaPrimary || ctaIsAffiliate ? 'onband' : 'ghost-onband'}
          target="_blank"
          rel="noopener noreferrer sponsored"
        >
          {tool.ctaLabel} <span aria-hidden="true">&rarr;</span>
        </Button>
        <span class="hub-badge">{tool.badge}</span>
      </div>
      {priceStat && (
        <dl class="hub-stat">
          <Stat value={priceStat.value} label={priceStat.label} source={priceStat.source} tone="deep" />
        </dl>
      )}
    </div>
    {ctaIsAffiliate && (
      <p class="hub-disclosure">
        This is an affiliate link: we may earn a commission at no extra cost to you. <a href="/disclosure/">Disclosure</a>.
      </p>
    )}
  </PageHead>

  <div class="listing-main"><Container size="wide">

    {tool.bestFor && (
      <p class="tool-hub-bestfor"><strong>Best for:</strong> {tool.bestFor}</p>
    )}

    {tool.body && tool.body.length > 0 && (
      <div class="tool-hub-body">
        {tool.body.map((para) => (
          <p>{para}</p>
        ))}
      </div>
    )}

    <ToolPricing slug={tool.slug} />

    <!-- Articles mentioning this tool -->
    <h2 class="hub-h2">
      {posts.length > 0
        ? `${posts.length} article${posts.length === 1 ? '' : 's'} mentioning ${tool.name}`
        : `Articles mentioning ${tool.name}`}
    </h2>

    {posts.length > 0 ? (
      <div class="card-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p style="color:var(--text-muted);font-size:1.0625rem;">
        We haven't published a dedicated article on {tool.name} yet; it's on the list. In the
        meantime, browse the <a href="/blog/">full blog</a> or see all our <a href="/tools/">tools</a>.
      </p>
    )}

    {tool.faqs && tool.faqs.length > 0 && (
      <section class="tool-hub-faqs">
        <h2 class="hub-h2">Frequently asked questions</h2>
        {tool.faqs.map((f) => (
          <div class="tool-hub-faq">
            <h3>{f.question}</h3>
            <p>{f.answer}</p>
          </div>
        ))}
      </section>
    )}

    <p class="hub-back"><a href="/tools/">&larr; All tools</a></p>
  </Container></div>

  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</BaseLayout>

<style>
  /* ── Band (2026-10, docs/DESIGN-SYSTEM.md) ── */
  .hub-logo { display: flex; align-items: center; justify-content: center; width: 84px; height: 84px; background: #fff; border-radius: var(--radius-md); }
  .hub-logo img { width: 56px; height: 56px; object-fit: contain; }
  .hub-logo span { font: 600 var(--step-5)/1 var(--font-serif); color: var(--ink-900); }
  .hub-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-top: 1.5rem; }
  .tool-hub-actions { display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap; min-width: 0; }
  .hub-badge { display: inline-block; padding: 0.3rem 0.55rem; border: 1px solid var(--band-line); border-radius: 4px; font: 600 0.75rem/1.2 var(--font-sans); letter-spacing: 0.02em; color: var(--band-muted); }
  .hub-stat { margin: 0; min-width: 0; max-width: 22rem; }
  .hub-disclosure { margin: 1rem 0 0; font: 400 0.85rem/1.5 var(--font-sans); color: var(--band-faint); }
  .hub-disclosure a { text-decoration: underline; text-underline-offset: 2px; }

  /* ── Reading surface ── */
  .hub-h2 { margin: 2.5rem 0 1.25rem; font: 600 var(--step-4)/1.2 var(--font-serif); letter-spacing: -0.015em; color: var(--ink-900); }
  .hub-back { margin: 3rem 0 0; font: 600 0.95rem var(--font-sans); }
  .tool-hub-bestfor {
    max-width: var(--measure);
    margin: 0 0 1.75rem;
    padding: 1rem 1.2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--tag-teal-700);
    border-radius: var(--radius-md);
    color: var(--ink-800);
    font: 400 var(--step-1)/1.6 var(--font-sans);
  }
  .tool-hub-body {
    max-width: var(--measure);
    margin-bottom: 2.5rem;
  }
  .tool-hub-body p {
    color: var(--ink-700);
    font-size: var(--step-1);
    line-height: 1.7;
    margin-bottom: 1.1rem;
  }
  .tool-hub-faqs {
    max-width: var(--measure);
    margin-top: 3rem;
  }
  @media (max-width: 720px) {
    .hub-logo { width: 64px; height: 64px; }
    .hub-logo img { width: 44px; height: 44px; }
    .hub-stat { max-width: none; width: 100%; }
  }
  .tool-hub-faq {
    margin-bottom: 1.5rem;
  }
  .tool-hub-faq h3 {
    font-size: 1.125rem;
    margin-bottom: 0.4rem;
  }
  .tool-hub-faq p {
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }
</style>
