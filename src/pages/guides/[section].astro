---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import ItemListSchema from '../../components/ItemListSchema.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Container from '../../components/ui/Container.astro';
import { sections, getSectionPosts, type Section } from '../../data/sections';

export async function getStaticPaths() {
  return sections.map((s) => ({ params: { section: s.slug }, props: { section: s } }));
}

interface Props {
  section: Section;
}

const { section } = Astro.props;
const posts = await getSectionPosts(section);
---

<BaseLayout title={section.title} description={section.description}>
  <PageHead eyebrow={`Guides by format · ${posts.length} articles`} title={section.title} lede={section.description} />
  <div class="listing-main"><Container size="wide">

    <div class="prose guide-hub-intro">
      {section.intro.map((para) => <p set:html={para} />)}
    </div>

    {posts.length > 0 ? (
      <div class="card-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <div class="empty-state">
        <p>
          New {section.navLabel.toLowerCase()} are on the way. <a href="/blog/">Browse all articles</a> in the meantime.
        </p>
      </div>
    )}
  </Container></div>
  <ItemListSchema name={section.title} items={posts.map((p) => ({ url: `/blog/${p.slug}/`, name: p.data.title }))} />
</BaseLayout>
