---
// /guides/ index. Only /guides/<section>/ existed, so the bare /guides/ URL a reader
// can type (or trim back to) was a 404 (conversion audit 2026-10-01, F10). Lists the
// format hubs from src/data/sections.ts plus /reviews/, which is that format's hub.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Container from '../../components/ui/Container.astro';
import { getCollection } from 'astro:content';
import { sections, getSectionPosts } from '../../data/sections';
import { classifySection } from '../../lib/post-cards';

const hubs = await Promise.all(
  sections.map(async (s) => ({ href: `/guides/${s.slug}/`, name: s.navLabel, desc: s.description, count: (await getSectionPosts(s)).length })),
);
const reviewCount = (await getCollection('blog', ({ data }) => !data.draft)).filter((p) => classifySection(p) === 'Review').length;
const tiles = [
  ...hubs,
  { href: '/reviews/', name: 'Reviews', desc: 'Single-tool reviews: what a tool is good at, where it falls short, and who should buy it.', count: reviewCount },
];
---

<BaseLayout
  title="Guides by format"
  description="Migration guides, head-to-head tool comparisons, pricing breakdowns, and single-tool reviews for RevOps and GTM teams."
>
  <PageHead
    eyebrow="Guides by format"
    title="Guides"
    lede="Pick the kind of answer you need: how to move between tools, which tool wins, or what it really costs."
  />
  <div class="listing-main"><Container size="wide">
    <ul class="hub-tiles">
      {tiles.map((h) => (
        <li>
          <a href={h.href}>
            <span class="hub-tile-top"><span class="hub-tile-name">{h.name}</span><small>{h.count} articles</small></span>
            <span class="hub-tile-desc">{h.desc}</span>
            <span class="hub-tile-go">Open <span aria-hidden="true">&rarr;</span></span>
          </a>
        </li>
      ))}
    </ul>
  </Container></div>
</BaseLayout>
