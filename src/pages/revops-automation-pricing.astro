---
import Band from '../components/ui/Band.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { tools } from '../data/tools';
import index from '../data/pricing-index.json';

// The dataset is built by pricing/build-pricing-index.mjs and committed, so the page
// is a pure render of a reviewable file rather than a live scrape at build time.
// Every figure below traces to a vendor URL and the date it was read.
type Plan = { name?: string; monthlyBilledMonthly?: number | null; monthlyBilledAnnually?: number | null; unitIncluded?: string | null };
type Row = {
  slug: string; name: string; category: string; status: string;
  extraction?: string; sourceUrl?: string; reason?: string;
  currency?: string | null; hasFreeTier?: boolean | null; freeTierLimit?: string | null;
  entryPaidPlan?: Plan | null; pricingUnit?: string | null; minimumSeats?: number | null;
  highestPublishedPlan?: Plan | null; enterpriseIsQuoteOnly?: boolean | null;
  apiOnPaidTierOnly?: boolean | null; notes?: string | null;
};

const data = index as unknown as { generatedAt: string; method: string; counts: Record<string, number>; tools: Row[] };
const rows = data.tools;
const priced = rows.filter((r) => r.status === 'ok');
const unpriced = rows.filter((r) => r.status !== 'ok');

// A hub exists for every registered tool, so linking each row to its own page turns
// this into an internal-link source for the /tools/ hubs rather than a dead end.
const hubSlugs = new Set(tools.map((t) => t.slug));

const categories = [...new Set(priced.map((r) => r.category))].sort();

const money = (n: number | null | undefined, cur: string | null | undefined) => {
  if (n == null) return null;
  const sym = cur === 'EUR' ? '€' : cur === 'GBP' ? '£' : '$';
  return `${sym}${Number.isInteger(n) ? n : n.toFixed(2)}`;
};

const entryDisplay = (r: Row) => {
  const p = r.entryPaidPlan;
  if (!p) return null;
  const annual = money(p.monthlyBilledAnnually, r.currency);
  const monthly = money(p.monthlyBilledMonthly, r.currency);
  return { name: p.name || null, annual, monthly, unit: p.unitIncluded || null };
};

// Count how much of the table is actually populated, and say so on the page. A price
// index that quietly renders blanks as if they were zeroes is worse than no index.
const filled = priced.filter((r) => r.entryPaidPlan?.monthlyBilledAnnually != null || r.entryPaidPlan?.monthlyBilledMonthly != null).length;

const totalVendors = rows.length;
const pageTitle = `RevOps Tools Pricing Comparison: What ${priced.length} Tools Cost`;
const pageDesc = `What RevOps and sales automation tools cost: entry price, free tier and billing unit for ${priced.length} of ${totalVendors} vendors, read from their own pricing pages on ${data.generatedAt}. Blanks, not guesses. CC BY 4.0.`;

const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: pageTitle,
  description: pageDesc,
  url: 'https://theautomationsguide.com/revops-automation-pricing/',
  dateModified: data.generatedAt,
  creator: { '@type': 'Organization', name: 'The Automations Guide', url: 'https://theautomationsguide.com/' },
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
  measurementTechnique: data.method,
  distribution: [{
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: 'https://theautomationsguide.com/data/revops-pricing-index.json',
  }],
};
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(datasetLd)} />

  <Band class="pi-hero">
    <Container size="wide">
      <div class="hero-eyebrow">Open data &middot; Updated {data.generatedAt}</div>
      <h1>RevOps tools pricing comparison: what sales automation tools cost</h1>
      <p class="pi-lede">
        What RevOps and sales automation tools cost to start using, compared in one table: entry
        price, what the free tier gives you, and what you are billed per (seat, flat, credits, or
        usage). {priced.length} of {totalVendors} vendors are priced here, each read from its own
        pricing page.
      </p>
      <p class="pi-sub">
        Every figure here was read from the vendor's own pricing page on {data.generatedAt}, and
        every row links to the exact page it came from. Where a vendor does not publish a number,
        the cell is blank on purpose. Nothing is estimated, and nothing is carried over from a
        previous version of a vendor's pricing. The dataset is free to reuse under CC BY 4.0.
      </p>
      <div class="pi-actions">
        <Button href="/data/revops-pricing-index.json" variant="onband" download>Download the raw JSON</Button>
        <Button href="#method" variant="ghost-onband">How this was built</Button>
      </div>
    </Container>
  </Band>

  <!-- container--wide, not container: at the default reading width the table's
       rightmost column (the source citation) falls outside the scroll box, which
       hides the one thing that makes this page worth citing. -->
  <section class="container--wide pi-section">
    <div class="pi-stats">
      <div class="pi-stat"><strong>{priced.length}</strong><span>tools with published pricing</span></div>
      <div class="pi-stat"><strong>{filled}</strong><span>with a machine-readable entry price</span></div>
      <div class="pi-stat"><strong>{priced.filter((r) => r.hasFreeTier).length}</strong><span>offering a genuine free tier</span></div>
      <div class="pi-stat"><strong>{priced.filter((r) => r.enterpriseIsQuoteOnly).length}</strong><span>gating their top tier behind a sales call</span></div>
    </div>

    <div class="pi-filter">
      <label for="pi-cat">Filter by category</label>
      <select id="pi-cat">
        <option value="">All categories</option>
        {categories.map((c) => <option value={c}>{c}</option>)}
      </select>
      <span class="pi-count" id="pi-count">{priced.length} tools</span>
    </div>

    <div class="pi-tablewrap">
      <table class="pi-table">
        <thead>
          <tr>
            <th scope="col">Tool</th>
            <th scope="col">Free tier</th>
            <th scope="col">Entry paid plan</th>
            <th scope="col">Billed per</th>
            <th scope="col">Top published tier</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          {priced.map((r) => {
            const e = entryDisplay(r);
            return (
              <tr data-cat={r.category}>
                <th scope="row">
                  {hubSlugs.has(r.slug)
                    ? <a href={`/tools/${r.slug}/`}>{r.name}</a>
                    : r.name}
                  <span class="pi-cat">{r.category}</span>
                </th>
                <td>
                  {r.hasFreeTier === true
                    ? <><span class="pi-yes">Yes</span>{r.freeTierLimit && <span class="pi-note">{r.freeTierLimit}</span>}</>
                    : r.hasFreeTier === false ? <span class="pi-no">No</span> : <span class="pi-blank" title="Not stated on the vendor's pricing page">not stated</span>}
                </td>
                <td>
                  {e && (e.annual || e.monthly) ? (
                    <>
                      {e.name && <span class="pi-plan">{e.name}</span>}
                      <span class="pi-price">
                        {e.annual ? <>{e.annual}<small>/mo billed annually</small></> : <>{e.monthly}<small>/mo</small></>}
                      </span>
                      {e.annual && e.monthly && <span class="pi-note">{e.monthly}/mo billed monthly</span>}
                      {e.unit && <span class="pi-note">includes {e.unit}</span>}
                    </>
                  ) : <span class="pi-blank" title="No entry price stated in the page we read">not published</span>}
                </td>
                <td>{r.pricingUnit ? <span class="pi-unit">{r.pricingUnit}</span> : <span class="pi-blank">&mdash;</span>}
                  {r.minimumSeats != null && <span class="pi-note">min {r.minimumSeats} seat{r.minimumSeats === 1 ? '' : 's'}</span>}
                </td>
                <td>
                  {r.highestPublishedPlan?.monthlyBilledAnnually != null
                    ? <><span class="pi-plan">{r.highestPublishedPlan.name}</span><span class="pi-price">{money(r.highestPublishedPlan.monthlyBilledAnnually, r.currency)}<small>/mo</small></span></>
                    : r.enterpriseIsQuoteOnly ? <span class="pi-quote">quote only</span> : <span class="pi-blank">&mdash;</span>}
                </td>
                <td>
                  {r.sourceUrl && <a class="pi-src" href={r.sourceUrl} rel="nofollow noopener" target="_blank">vendor page</a>}
                  <span class="pi-note">read {data.generatedAt}</span>
                  {r.extraction === 'assisted' && <span class="pi-note pi-assisted" title="This vendor blocks automated requests, so the page was read manually. Same source, same date.">read manually</span>}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    {priced.some((r) => r.notes) && (
      <details class="pi-details">
        <summary>Caveats recorded per tool ({priced.filter((r) => r.notes).length})</summary>
        <ul class="pi-notes">
          {priced.filter((r) => r.notes).map((r) => <li><strong>{r.name}:</strong> {r.notes}</li>)}
        </ul>
      </details>
    )}
  </section>

  <section class="container pi-section" id="method">
    <h2>How this was built, and what it does not cover</h2>
    <p>
      A script reads each vendor's public pricing page and extracts the figures into a
      committed JSON file. The extractor is explicitly forbidden from using prior knowledge of
      a brand: if a number is not literally present in the page it just read, it records a blank
      and a reason instead of a guess. A validation pass then re-checks every extracted price
      against the source text and discards any figure it cannot find there, which catches the
      failure mode where a plausible-looking price is invented.
    </p>
    <p>
      That discipline is the entire point, so it is worth being blunt about the cost: this
      table has real gaps. {filled} of {priced.length} tools yielded a machine-readable entry
      price. The rest publish pricing in a form the extractor could read only partly, and a
      blank cell means "we could not verify this", never "this is free" or "this is
      unavailable".
    </p>

    {unpriced.length > 0 && (
      <>
        <h3>{unpriced.length} tools are not in the table above</h3>
        <p>Listed here rather than silently dropped, because which tools are missing is itself information:</p>
        <ul class="pi-missing">
          {unpriced.map((r) => (
            <li>
              <strong>{r.name}</strong>
              <span class={`pi-tag pi-tag--${r.status}`}>{r.status.replace(/-/g, ' ')}</span>
              {r.reason && <span class="pi-note">{r.reason}</span>}
            </li>
          ))}
        </ul>
      </>
    )}

    <h3>Reuse and corrections</h3>
    <p>
      The dataset is published under <a href="https://creativecommons.org/licenses/by/4.0/" rel="nofollow noopener" target="_blank">CC BY 4.0</a>:
      use it, chart it, quote it, with a link back. If you spot a figure that is wrong or out of
      date, <a href="/about/">tell us</a> and it gets fixed in the next build. Vendors change
      pricing without notice, so treat the read date on each row as the expiry stamp it is.
    </p>
    <p class="pi-disclosure">
      Some tool names link to our own review pages, and some of those pages carry affiliate
      links. None of that influences a number in this table: the figures come from the vendors'
      pricing pages, not from us. <a href="/disclosure/">Full disclosure</a>.
    </p>
  </section>
</BaseLayout>

<style>
  /* 2026-10 ("Ink spec"): the hero is the ink frame; the table is a white,
     hairline, product-grade data table with a sticky header and first column. */
  :global(.pi-hero) { padding: 2.75rem 0 3rem; }
  :global(.pi-hero) .hero-eyebrow { color: var(--band-accent); margin-bottom: 0.9rem; }
  :global(.pi-hero) h1 { color: #fff; margin: 0 0 1rem; max-width: 900px; font: 600 clamp(2rem, 4vw, var(--step-6))/1.1 var(--font-serif); letter-spacing: -0.02em; }
  .pi-lede { font: 400 var(--step-2)/1.55 var(--font-sans); color: var(--band-muted); max-width: 72ch; margin: 0 0 0.85rem; }
  .pi-sub { font: 400 0.95rem/1.6 var(--font-sans); color: var(--band-faint); max-width: 80ch; margin: 0; }
  .pi-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .pi-section { padding: 2rem 0 2.5rem; }

  .pi-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; margin-bottom: 1.75rem; }
  .pi-stat { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.1rem 1.15rem; min-width: 0; }
  .pi-stat strong { display: block; font: 700 var(--step-5)/1 var(--font-sans); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; color: var(--ink-900); }
  .pi-stat span { display: block; margin-top: 0.4rem; font: 400 0.85rem/1.4 var(--font-sans); color: var(--text-muted); }

  .pi-filter { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .pi-filter label { font: 600 0.9rem var(--font-sans); color: var(--ink-900); }
  .pi-filter select { min-height: 44px; padding: 0 2rem 0 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--border-strong); background: #fff; font: 400 0.95rem var(--font-sans); color: var(--ink-900); }
  .pi-count { font: 400 0.85rem var(--font-sans); color: var(--text-muted); }

  /* The table scrolls inside its own box so the page body never does. */
  .pi-tablewrap { overflow: auto; max-height: 80vh; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); }
  .pi-table { width: 100%; border-collapse: separate; border-spacing: 0; font: 400 0.9rem/1.45 var(--font-sans); font-variant-numeric: tabular-nums; min-width: 880px; }
  .pi-table th, .pi-table td { text-align: left; padding: 0.8rem 0.95rem; vertical-align: top; border-bottom: 1px solid var(--border); background: var(--bg-card); }
  .pi-table thead th { position: sticky; top: 0; z-index: 2; background: var(--cream-3); color: var(--ink-900); font: 600 0.82rem/1.3 var(--font-sans); }
  .pi-table tbody tr:last-child th, .pi-table tbody tr:last-child td { border-bottom: 0; }
  .pi-table tbody tr:hover > * { background: var(--bg); }
  /* First column stays put while the row scrolls (390 px). */
  .pi-table th:first-child { position: sticky; left: 0; z-index: 1; box-shadow: 1px 0 0 var(--border); }
  .pi-table thead th:first-child { z-index: 3; }
  .pi-table th[scope='row'] { font-weight: 600; color: var(--ink-900); }
  .pi-table th[scope='row'] a { color: var(--ink-900); text-decoration: underline; text-decoration-color: var(--border-strong); text-underline-offset: 3px; }
  .pi-table th[scope='row'] a:hover { color: var(--accent-text); text-decoration-color: currentColor; }

  .pi-table th:nth-child(1), .pi-table td:nth-child(1) { width: 17%; }
  .pi-table th:nth-child(2), .pi-table td:nth-child(2) { width: 13%; }
  .pi-table th:nth-child(3), .pi-table td:nth-child(3) { width: 30%; }
  .pi-table th:nth-child(4), .pi-table td:nth-child(4) { width: 11%; }
  .pi-table th:nth-child(5), .pi-table td:nth-child(5) { width: 15%; }
  .pi-table th:nth-child(6), .pi-table td:nth-child(6) { width: 14%; }

  .pi-cat, .pi-note { display: block; font-size: 0.76rem; font-weight: 400; color: var(--text-muted); margin-top: 0.2rem; }
  .pi-plan { display: block; font-weight: 600; color: var(--ink-900); }
  .pi-price { display: block; font: 700 1.05rem/1.3 var(--font-sans); color: var(--ink-900); }
  .pi-price small { font: 400 0.72rem var(--font-sans); color: var(--text-muted); margin-left: 0.2rem; }
  .pi-yes { color: var(--tag-teal-800); font-weight: 600; }
  .pi-no { color: var(--ink-600); }
  .pi-blank { color: var(--text-muted); font-style: italic; font-size: 0.85rem; }
  .pi-quote { font-size: 0.85rem; color: var(--ink-700); }
  .pi-unit { font-size: 0.88rem; color: var(--ink-700); }
  .pi-assisted { font-style: italic; }
  .pi-src { font-size: 0.85rem; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

  .pi-details { margin-top: 1.5rem; }
  .pi-details summary { cursor: pointer; font: 600 0.95rem var(--font-sans); color: var(--ink-900); }
  .pi-notes { margin-top: 0.75rem; font-size: 0.9rem; line-height: 1.6; }
  .pi-missing { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .pi-missing li { border-left: 3px solid var(--border); padding-left: 0.75rem; }
  .pi-tag { display: inline-block; margin-left: 0.5rem; font: 600 0.72rem var(--font-sans); text-transform: uppercase; letter-spacing: 0.04em; padding: 0.15rem 0.4rem; border-radius: 3px; background: var(--cream-3); color: var(--ink-700); }
  .pi-disclosure { font-size: 0.85rem; color: var(--text-muted); }
  #method h2 { font: 600 var(--step-4)/1.2 var(--font-serif); color: var(--ink-900); letter-spacing: -0.015em; }
  #method p { max-width: var(--measure); }
  #method a { text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 900px) { .pi-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .pi-table { font-size: 0.85rem; }
    .pi-stat strong { font-size: var(--step-4); }
    .pi-tablewrap { max-height: none; }
  }
</style>

<script is:inline>
  (function () {
    var sel = document.getElementById('pi-cat');
    var count = document.getElementById('pi-count');
    if (!sel) return;
    sel.addEventListener('change', function () {
      var want = sel.value;
      var shown = 0;
      document.querySelectorAll('.pi-table tbody tr').forEach(function (tr) {
        var match = !want || tr.getAttribute('data-cat') === want;
        tr.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      if (count) count.textContent = shown + (shown === 1 ? ' tool' : ' tools');
    });
  })();
</script>
