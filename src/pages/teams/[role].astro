---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import ItemListSchema from '../../components/ItemListSchema.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Container from '../../components/ui/Container.astro';
import { audiences, getAudiencePosts, type Audience } from '../../data/audiences';

export async function getStaticPaths() {
  return audiences.map((a) => ({ params: { role: a.slug }, props: { audience: a } }));
}

interface Props {
  audience: Audience;
}

const { audience } = Astro.props;
const posts = await getAudiencePosts(audience);
const teamWord = audience.navLabel.replace(/^For /, '');
---

<BaseLayout title={audience.title} description={audience.description}>
  <PageHead eyebrow={`For ${teamWord} teams · ${posts.length} articles`} title={audience.title} lede={audience.description} />
  <div class="listing-main"><Container size="wide">

    {posts.length > 0 ? (
      <div class="card-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <div class="empty-state">
        <p>
          New guides for this team are on the way. <a href="/blog/">Browse all articles</a> in the meantime.
        </p>
      </div>
    )}
  </Container></div>
  <ItemListSchema name={audience.title} items={posts.map((p) => ({ url: `/blog/${p.slug}/`, name: p.data.title }))} />
</BaseLayout>
