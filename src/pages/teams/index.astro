---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItemListSchema from '../../components/ItemListSchema.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Container from '../../components/ui/Container.astro';
import { audiences, getAudiencePosts } from '../../data/audiences';

const counts = await Promise.all(
  audiences.map(async (a) => [a.slug, (await getAudiencePosts(a)).length] as const),
);
const countBySlug = Object.fromEntries(counts);
---

<BaseLayout
  title="Browse by Team"
  description="RevOps and GTM automation guides, tool reviews, and playbooks organized by team: sales, RevOps, marketing, and founders."
>
  <PageHead
    eyebrow="Browse by team"
    title="Find the playbooks for your team"
    lede="RevOps and GTM automation, organized by who you are and the problems you own."
  />
  <div class="listing-main"><Container size="wide">
    <ul class="hub-tiles">
      {audiences.map((a) => (
        <li>
          <a href={`/teams/${a.slug}/`}>
            <span class="hub-tile-top"><span class="hub-tile-name">{a.navLabel}</span><small>{countBySlug[a.slug]} article{countBySlug[a.slug] === 1 ? '' : 's'}</small></span>
            <span class="hub-tile-desc">{a.description}</span>
            <span class="hub-tile-go">View guides <span aria-hidden="true">&rarr;</span></span>
          </a>
        </li>
      ))}
    </ul>
  </Container></div>
  <ItemListSchema name="Browse by Team" items={audiences.map((a) => ({ url: `/teams/${a.slug}/`, name: a.navLabel }))} />
</BaseLayout>
