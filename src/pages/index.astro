---
// Home (design program 2026-10, direction "Ink spec", docs/DESIGN-SYSTEM.md).
// No hero image: the content is the hero. Ink frames the top; everything below
// is cream/white. Every number on this page is computed from committed data.
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailSignup from '../components/EmailSignup.astro';
import PostCard from '../components/PostCard.astro';
import Band from '../components/ui/Band.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Stat from '../components/ui/Stat.astro';
import { getCollection } from 'astro:content';
import { tools, toolCategories, categoryAnchor } from '../data/tools';
import { audiences } from '../data/audiences';
import { sections, getSectionPosts } from '../data/sections';
import { classifySection } from '../lib/post-cards';
import { toolsCompared } from '../lib/tools-compared';
import pricingIndexRaw from '../data/pricing-index.json';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latest = allPosts.slice(0, 6);
const fmtShort = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

// Hero panel: a real comparison, shown with its tools' entry prices from the
// pricing index. A post with `featured: true` wins; otherwise the site's top
// entry post by sessions (PostHog 408442, 90 days to 2026-10-01, conversion audit).
const TOP_ENTRY_SLUG = '2026-05-06-apollo-vs-clay-vs-linkedin-sales-nav-best-for-outbound-2026';
const heroPost =
  allPosts.find((p) => (p.data as { featured?: boolean }).featured) ??
  allPosts.find((p) => p.slug === TOP_ENTRY_SLUG) ??
  allPosts[0];
const heroTools = toolsCompared(heroPost.body, heroPost.data.title).slice(0, 4);
const heroLabel = (heroPost.data as { featured?: boolean }).featured ? 'Featured comparison' : 'Most-read comparison';

// Editorial sections by format (audit Phase 3): Tool vs tool leads with cards;
// the other formats are compact lists so the page stays one idea per section.
const formatSections = await Promise.all(
  sections.map(async (s) => ({
    slug: s.slug,
    heading: s.navLabel,
    href: `/guides/${s.slug}/`,
    posts: (await getSectionPosts(s)).slice(0, 4),
  })),
);
const reviewPosts = allPosts.filter((p) => classifySection(p) === 'Review').slice(0, 4);
const vsSection = formatSections.find((s) => s.slug === 'tool-vs-tool') ?? formatSections[0];
const listSections = [
  ...formatSections.filter((s) => s !== vsSection),
  { slug: 'reviews', heading: 'Reviews', href: '/reviews/', posts: reviewPosts },
];

// Pricing-index band: read from the committed dataset, never hand-typed.
type PricingRow = {
  status: string;
  hasFreeTier?: boolean | null;
  entryPaidPlan?: { monthlyBilledMonthly?: number | null; monthlyBilledAnnually?: number | null } | null;
};
const pricingIndex = pricingIndexRaw as unknown as { generatedAt: string; counts: Record<string, number>; tools: PricingRow[] };
const totalTracked = pricingIndex.tools.length;
const pricedTools = pricingIndex.tools.filter((r) => r.status === 'ok');
const freeTierCount = pricedTools.filter((r) => r.hasFreeTier === true).length;
const entryValues = pricedTools
  .map((r) => r.entryPaidPlan?.monthlyBilledAnnually ?? r.entryPaidPlan?.monthlyBilledMonthly)
  .filter((v): v is number => v != null)
  .sort((a, b) => a - b);
const medianEntry = entryValues.length
  ? entryValues.length % 2 === 0
    ? (entryValues[entryValues.length / 2 - 1] + entryValues[entryValues.length / 2]) / 2
    : entryValues[(entryValues.length - 1) / 2]
  : null;
const fmtMoney = (n: number) => (Number.isInteger(n) ? `$${n}` : `$${n.toFixed(2)}`);
const readDate = new Date(`${pricingIndex.generatedAt}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const pricingStats = [
  { value: String(pricedTools.length), label: `of ${totalTracked} tools priced from the vendor's own page` },
  { value: String(freeTierCount), label: 'priced tools with a genuine free tier' },
  { value: medianEntry != null ? fmtMoney(medianEntry) : 'n/a', label: `median entry price a month, across ${entryValues.length} tools` },
  { value: 'CC BY', label: 'free to reuse with attribution' },
];

// Tools by job: every /tools/ category with its listed-tool count.
const listedTools = tools.filter((t) => t.listed !== false);
const categories = toolCategories
  .map((c) => ({ name: c, count: listedTools.filter((t) => t.category === c).length, href: `/tools/#${categoryAnchor(c)}` }))
  .filter((c) => c.count > 0);
---

<BaseLayout
  title="The Automations Guide"
  description="Independent comparisons, migration guides and an open pricing index for RevOps and GTM tools. Written by a practitioner; every price read from the vendor's own page and dated."
>
  <Band class="home-hero">
    <Container size="wide">
      <div class="home-hero-grid">
        <div class="home-hero-copy">
          <p class="home-eyebrow">RevOps and GTM tools, compared</p>
          <h1>Know what a RevOps tool costs, and what it is for, before the sales call.</h1>
          <p class="home-sub">
            Comparisons, migration guides and an open pricing index for {totalTracked} tools, written by a
            practitioner. Every price is read from the vendor's own page and dated.
          </p>
          <div class="home-actions">
            <Button href="/guides/tool-vs-tool/" variant="onband">Browse comparisons</Button>
            <Button href="/revops-automation-pricing/" variant="ghost-onband">Open the pricing index</Button>
          </div>
        </div>
        {heroTools.length > 0 && (
          <a class="home-panel" href={`/blog/${heroPost.slug}/`}>
            <span class="home-panel-head">
              <span><strong>{heroLabel}</strong></span>
              <span>prices read {readDate}</span>
            </span>
            <span class="home-panel-title">{heroPost.data.title}</span>
            <span class="home-panel-rows">
              {heroTools.map((t) => (
                <span class="home-panel-row">
                  <span class="home-panel-tool">
                    <span class="home-panel-logo">{t.logo && <img src={t.logo} alt="" width="20" height="20" decoding="async" />}</span>
                    {t.name}
                  </span>
                  <span class="home-panel-price">{t.price ? `${t.price.amount}/mo` : 'not indexed'}</span>
                  <span class="home-panel-tag">{t.tagline ?? ''}</span>
                </span>
              ))}
            </span>
            <span class="home-panel-cta">Read the comparison <span aria-hidden="true">&rarr;</span></span>
          </a>
        )}
      </div>
    </Container>
  </Band>

  <Container size="wide">
    <section class="home-sect" aria-labelledby="latest">
      <SectionHead id="latest" title="Latest guides" href="/blog/" linkText={`All ${allPosts.length} guides`} />
      <ol class="home-latest">
        {latest.map((p) => (
          <li>
            <a href={`/blog/${p.slug}/`}>
              <time datetime={p.data.pubDate.toISOString()}>{fmtShort(p.data.pubDate)}</time>
              <span class="home-latest-kind">{classifySection(p)}</span>
              <span class="home-latest-title">{p.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="home-sect" aria-labelledby="vs">
      <SectionHead id="vs" title={vsSection.heading} href={vsSection.href} linkText="All comparisons" />
      <div class="card-grid">
        {vsSection.posts.slice(0, 3).map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <section class="home-sect home-formats" aria-label="More formats">
      {listSections.map((sec) => (
        <div class="home-format">
          <h2><a href={sec.href}>{sec.heading}</a></h2>
          <ul>
            {sec.posts.map((p) => <li><a href={`/blog/${p.slug}/`}>{p.data.title}</a></li>)}
          </ul>
          <a class="home-format-all" href={sec.href}>View all <span aria-hidden="true">&rarr;</span></a>
        </div>
      ))}
    </section>

    <section class="home-index" aria-labelledby="pricing-index">
      <div class="home-index-copy">
        <p class="home-eyebrow">Open data, rebuilt quarterly</p>
        <h2 id="pricing-index">The RevOps pricing index</h2>
        <p>
          Entry price, free tier and billing unit for {totalTracked} tools, each read from the vendor's own
          pricing page on {readDate}. Where a vendor does not publish a number, the cell stays empty.
        </p>
        <Button href="/revops-automation-pricing/" variant="onband">Open the index</Button>
      </div>
      <dl class="home-index-stats">
        {pricingStats.map((s) => <Stat value={s.value} label={s.label} tone="deep" />)}
      </dl>
    </section>

    <section class="home-sect" aria-labelledby="by-job">
      <SectionHead id="by-job" title="Tools by job" href="/tools/" linkText="All tools" />
      <ul class="home-cats">
        {categories.map((c) => (
          <li><a href={c.href}><span>{c.name}</span><small>{c.count}</small></a></li>
        ))}
      </ul>
      <p class="home-roles">
        Or start with your role:
        {audiences.map((a, i) => (<>{i > 0 && <span aria-hidden="true"> &middot; </span>}<a href={`/teams/${a.slug}/`}>{a.navLabel}</a></>))}
      </p>
    </section>

    <section class="home-author" aria-label="About the author">
      <img src="/images/ian-avatar.jpg" alt="Ian Chamberland" width="72" height="72" loading="lazy" />
      <p>
        <strong>Ian Chamberland</strong> writes everything on this site, mostly from RevOps and GTM stacks he has
        built or broken as founder of Homegrown Growth Co, a fractional RevOps practice. Every affiliate program is
        <a href="/disclosure/">disclosed by name</a>, and a tool with no program says so.
        <a href="/about/">More about Ian</a>.
      </p>
    </section>

    <section id="newsletter" class="home-sect section--anchor">
      <EmailSignup />
    </section>
  </Container>
</BaseLayout>

<style>
  :global(.home-hero) { padding: 3.5rem 0 4rem; }
  .home-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3.5rem; align-items: center; }
  .home-eyebrow { margin: 0 0 0.9rem; font: 600 0.8rem/1 var(--font-sans); letter-spacing: 0.07em; text-transform: uppercase; color: var(--band-accent); }
  :global(.home-hero) h1 { margin: 0 0 1rem; color: #fff; font: 600 clamp(2.1rem, 3.8vw, var(--step-6))/1.1 var(--font-serif); letter-spacing: -0.02em; }
  .home-sub { margin: 0 0 1.6rem; max-width: 560px; font: 400 var(--step-1)/1.6 var(--font-sans); color: var(--band-muted); }
  .home-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .home-panel { display: block; min-width: 0; background: var(--bg-card); color: var(--text); border-radius: var(--radius-md); box-shadow: 0 20px 48px rgba(0, 0, 0, 0.35); overflow: hidden; text-decoration: none; }
  .home-panel:hover { text-decoration: none; }
  .home-panel-head { display: flex; justify-content: space-between; gap: 1rem; padding: 0.75rem 1.1rem; background: var(--bg-secondary); border-bottom: 1px solid var(--border); font: 400 0.8rem/1.3 var(--font-sans); color: var(--text-muted); }
  .home-panel-head strong { color: var(--ink-900); font-weight: 600; }
  .home-panel-title { display: block; padding: 0.9rem 1.1rem 0.4rem; font: 600 var(--step-2)/1.3 var(--font-serif); color: var(--ink-900); }
  .home-panel-rows { display: block; padding: 0 1.1rem; }
  .home-panel-row { display: grid; grid-template-columns: minmax(0, 1.2fr) auto minmax(0, 1.4fr); gap: 0.25rem 1rem; align-items: center; padding: 0.7rem 0; border-bottom: 1px solid var(--border); font: 400 0.88rem/1.35 var(--font-sans); }
  .home-panel-tool { display: flex; align-items: center; gap: 0.55rem; font-weight: 600; color: var(--ink-900); min-width: 0; }
  .home-panel-logo { width: 28px; height: 28px; flex: none; border: 1px solid var(--border); border-radius: 6px; display: flex; align-items: center; justify-content: center; background: #fff; }
  .home-panel-logo img { width: 18px; height: 18px; object-fit: contain; }
  .home-panel-price { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ink-900); text-align: right; }
  .home-panel-tag { color: var(--text-muted); font-size: 0.82rem; }
  .home-panel-cta { display: block; padding: 0.85rem 1.1rem; font: 600 0.9rem var(--font-sans); color: var(--accent-text); }

  .home-sect { padding: 3rem 0 0.5rem; }
  .home-latest { list-style: none; margin: 0; padding: 0; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; }
  .home-latest li + li { border-top: 1px solid var(--border); }
  .home-latest a { display: grid; grid-template-columns: 4.5rem 9.5rem minmax(0, 1fr); gap: 1rem; align-items: baseline; padding: 0.85rem 1.1rem; text-decoration: none; }
  .home-latest a:hover { background: var(--bg); text-decoration: none; }
  .home-latest time { font: 400 0.82rem var(--font-mono); color: var(--text-muted); }
  .home-latest-kind { font: 600 0.72rem/1.2 var(--font-sans); letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-text); }
  .home-latest-title { font: 600 1rem/1.35 var(--font-sans); color: var(--ink-900); }

  .home-formats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .home-format { min-width: 0; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.2rem 1.25rem; display: flex; flex-direction: column; }
  .home-format h2 { margin: 0 0 0.6rem; font: 600 var(--step-2)/1.25 var(--font-serif); }
  .home-format h2 a { color: var(--ink-900); text-decoration: none; }
  .home-format ul { list-style: none; margin: 0 0 0.9rem; padding: 0; }
  .home-format li { padding: 0.5rem 0; border-top: 1px solid var(--border); }
  .home-format li a { font: 500 0.92rem/1.4 var(--font-sans); color: var(--ink-800); text-decoration: none; }
  .home-format li a:hover { color: var(--accent-text); text-decoration: underline; }
  .home-format-all { margin-top: auto; font: 600 0.88rem var(--font-sans); }

  .home-index { margin: 3.5rem 0 0.5rem; padding: 2.5rem; border-radius: var(--radius-xl); background: var(--deep); color: #fff; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 2.5rem; align-items: center; }
  .home-index h2 { margin: 0 0 0.6rem; color: #fff; font: 600 var(--step-5)/1.15 var(--font-serif); letter-spacing: -0.015em; }
  .home-index-copy p:not(.home-eyebrow) { margin: 0 0 1.4rem; font: 400 1rem/1.6 var(--font-sans); color: var(--deep-muted); }
  .home-index-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin: 0; }

  .home-cats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; }
  .home-cats a { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; min-height: 52px; padding: 0.7rem 0.9rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; color: var(--ink-900); font: 500 0.9rem/1.3 var(--font-sans); }
  .home-cats a:hover { border-color: var(--ink-300); text-decoration: none; }
  .home-cats small { flex: none; font: 600 0.78rem var(--font-sans); font-variant-numeric: tabular-nums; color: var(--text-muted); background: var(--bg-secondary); border-radius: 4px; padding: 0.2rem 0.45rem; }
  .home-roles { margin: 1rem 0 0; font: 400 0.92rem/1.6 var(--font-sans); color: var(--text-muted); }

  .home-author { display: flex; gap: 1.1rem; align-items: center; margin-top: 3rem; padding: 1.5rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .home-author img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; flex: none; }
  .home-author p { margin: 0; max-width: 820px; font: 400 1rem/1.6 var(--font-sans); color: var(--ink-700); }
  .home-author strong { color: var(--ink-900); }
  .home-author a { text-decoration: underline; text-underline-offset: 2px; }

  #newsletter { padding-bottom: 4rem; }

  @media (max-width: 1023px) {
    .home-hero-grid, .home-index { grid-template-columns: minmax(0, 1fr); }
    .home-cats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .home-formats { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    :global(.home-hero) { padding: 2.25rem 0 2.5rem; }
    .home-panel-row { grid-template-columns: minmax(0, 1fr) auto; }
    .home-panel-tag { grid-column: 1 / -1; }
    .home-latest a { grid-template-columns: minmax(0, 1fr); gap: 0.2rem; }
    .home-index { padding: 1.75rem 1.1rem; }
    .home-cats { grid-template-columns: minmax(0, 1fr); }
    .home-author { align-items: flex-start; }
  }
</style>
