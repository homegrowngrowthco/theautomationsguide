---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailSignup from '../components/EmailSignup.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { tools } from '../data/tools';
import { audiences } from '../data/audiences';
import { sections, getSectionPosts } from '../data/sections';
import { classifySection } from '../lib/post-cards';
import pricingIndexRaw from '../data/pricing-index.json';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// "Tools we cover" strip: dedupe by slug, stable order from the registry.
// Only listed tools appear here; pipeline tools (listed:false) still get a hub page.
const stripTools = tools.filter((t) => t.listed !== false);

// Editorial sections by format (replaces the old machine-derived "Browse by
// topic" tag tiles, per audit Phase 3). The 3 /guides/ hubs come from the
// sections.ts registry, all keyed off the SAME classifySection() classifier
// that drives the card generator's teal tab label. "Reviews" is built here
// directly rather than added to sections.ts: src/pages/reviews.astro is
// already the Review format's hub at /reviews/, so its "View all" points
// there instead of a duplicate /guides/reviews/.
const formatSections = await Promise.all(
  sections.map(async (s) => ({
    slug: s.slug,
    heading: s.navLabel,
    dek: s.dek,
    href: `/guides/${s.slug}/`,
    posts: (await getSectionPosts(s)).slice(0, 3),
  })),
);
const reviewPosts = allPosts
  .filter((p) => classifySection(p) === 'Review')
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const editorialSections = [
  ...formatSections,
  {
    slug: 'reviews',
    heading: 'Reviews',
    dek: 'One tool, used long enough to hit its limits, with the parts the vendor page leaves out.',
    href: '/reviews/',
    posts: reviewPosts,
  },
];

// Pricing-index band: every figure below is read from the committed dataset
// (pricing/build-pricing-index.mjs -> src/data/pricing-index.json), never
// hand-typed. Same field names/shape as src/pages/revops-automation-pricing.astro;
// that page exports nothing importable (it's a route, not a module), so this
// is a small parallel read of the same JSON rather than a duplicated scraper.
type PricingRow = {
  status: string;
  hasFreeTier?: boolean | null;
  currency?: string | null;
  entryPaidPlan?: { monthlyBilledMonthly?: number | null; monthlyBilledAnnually?: number | null } | null;
};
const pricingIndex = pricingIndexRaw as unknown as { generatedAt: string; tools: PricingRow[] };
const pricedTools = pricingIndex.tools.filter((r) => r.status === 'ok');
const freeTierCount = pricedTools.filter((r) => r.hasFreeTier === true).length;
const freeTierPct = Math.round((100 * freeTierCount) / pricedTools.length);
const entryValues = pricedTools
  .map((r) => r.entryPaidPlan?.monthlyBilledAnnually ?? r.entryPaidPlan?.monthlyBilledMonthly)
  .filter((v): v is number => v != null)
  .sort((a, b) => a - b);
const medianEntry = entryValues.length
  ? entryValues.length % 2 === 0
    ? (entryValues[entryValues.length / 2 - 1] + entryValues[entryValues.length / 2]) / 2
    : entryValues[(entryValues.length - 1) / 2]
  : null;
const fmtMoney = (n: number) => (Number.isInteger(n) ? `$${n}` : `$${n.toFixed(2)}`);

const pricingStats = [
  { number: String(pricedTools.length), label: 'Tools priced', description: "straight from the vendor's pricing page" },
  { number: `${freeTierPct}%`, label: 'Have a free tier', description: `${freeTierCount} of ${pricedTools.length} priced tools` },
  { number: medianEntry != null ? fmtMoney(medianEntry) : 'n/a', label: 'Median entry price', description: `across ${entryValues.length} tools with a published price` },
  { number: 'CC BY 4.0', label: 'Licence', description: 'free to reuse, with attribution' },
];
---

<BaseLayout
  title="The Automations Guide"
  description="The RevOps and GTM automation playbook: honest tool reviews, copy-paste workflows, and revenue operations strategy for go-to-market teams."
>
  <!-- Hero (split: copy + workflow visual) -->
  <section class="hero hero--split">
    <div class="container--wide">
      <div class="hero-split">
        <div class="hero-copy">
          <div class="hero-eyebrow">RevOps &middot; GTM &middot; Automation</div>
          <h1>The RevOps &amp; GTM automation playbook.</h1>
          <p>
            Honest tool reviews, copy-paste workflows, and revenue operations
            strategy for go-to-market teams that want to scale output, not headcount.
          </p>
          <div class="hero-actions">
            <a href="/blog/" class="btn btn--primary">Read the Blog &rarr;</a>
            <a href="/tools/" class="btn btn--ghost">Browse Tools</a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <svg viewBox="0 0 440 360" role="presentation" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <marker id="hv-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" fill="#cdc7b3"></path>
              </marker>
            </defs>
            <!-- connectors: equal 82px gaps between rows, S-curves end at top-center of dest node -->
            <g fill="none" stroke="#cdc7b3" stroke-width="2" marker-end="url(#hv-arrow)">
              <path d="M150 46 C200 46 200 46 246 46"></path>
              <path d="M325 72 C325 113 93 113 93 154"></path>
              <path d="M150 180 C200 180 200 180 246 180"></path>
              <path d="M325 206 C325 247 93 247 93 288"></path>
              <path d="M150 314 C200 314 230 314 246 314"></path>
            </g>
            <!-- accent flow dots at midpoint of each horizontal connector -->
            <g fill="#14a890">
              <circle cx="200" cy="46" r="3.5"></circle>
              <circle cx="200" cy="180" r="3.5"></circle>
              <circle cx="200" cy="314" r="3.5"></circle>
            </g>
            <!-- nodes: tool logo (26x26 in rounded bg card, text to right) -->
            <!-- Row 1: n8n Trigger → Clay Enrich -->
            <g class="hv-node">
              <rect x="36" y="20" width="114" height="52" rx="12" fill="#ffffff" stroke="#e5e1d4"></rect>
              <rect x="48" y="31" width="28" height="28" rx="6" fill="#f4f1ec"></rect>
              <image x="49" y="32" width="26" height="26" href="/brand/tools/n8n.svg" preserveAspectRatio="xMidYMid meet"></image>
              <text x="84" y="42" text-anchor="start" font-size="12" font-weight="700" fill="#262b32">Trigger</text>
              <text x="84" y="56" text-anchor="start" font-size="10" fill="#5e6671">n8n</text>
            </g>
            <g class="hv-node">
              <rect x="246" y="20" width="158" height="52" rx="12" fill="#ffffff" stroke="#e5e1d4"></rect>
              <rect x="258" y="31" width="28" height="28" rx="6" fill="#f4f1ec"></rect>
              <image x="259" y="32" width="26" height="26" href="/brand/tools/clay.webp" preserveAspectRatio="xMidYMid meet"></image>
              <text x="294" y="42" text-anchor="start" font-size="12" font-weight="700" fill="#262b32">Enrich</text>
              <text x="294" y="56" text-anchor="start" font-size="10" fill="#5e6671">Clay</text>
            </g>
            <!-- Row 2: Apollo Qualify → HubSpot Sync to CRM -->
            <g class="hv-node">
              <rect x="36" y="154" width="114" height="52" rx="12" fill="#ffffff" stroke="#e5e1d4"></rect>
              <rect x="48" y="165" width="28" height="28" rx="6" fill="#f4f1ec"></rect>
              <image x="49" y="166" width="26" height="26" href="/brand/tools/apollo.svg" preserveAspectRatio="xMidYMid meet"></image>
              <text x="84" y="176" text-anchor="start" font-size="12" font-weight="700" fill="#262b32">Qualify</text>
              <text x="84" y="190" text-anchor="start" font-size="10" fill="#5e6671">Apollo</text>
            </g>
            <g class="hv-node">
              <rect x="246" y="154" width="158" height="52" rx="12" fill="#14a890" stroke="#14a890"></rect>
              <rect x="258" y="165" width="28" height="28" rx="6" fill="rgba(255,255,255,0.9)"></rect>
              <image x="259" y="166" width="26" height="26" href="/brand/tools/hubspot.svg" preserveAspectRatio="xMidYMid meet"></image>
              <text x="294" y="176" text-anchor="start" font-size="12" font-weight="700" fill="#ffffff">Sync to CRM</text>
              <text x="294" y="190" text-anchor="start" font-size="10" fill="#e6fbf6">HubSpot</text>
            </g>
            <!-- Row 3: Instantly Sequence → Pipedrive Pipeline -->
            <g class="hv-node">
              <rect x="36" y="288" width="114" height="52" rx="12" fill="#ffffff" stroke="#e5e1d4"></rect>
              <rect x="48" y="299" width="28" height="28" rx="6" fill="#f4f1ec"></rect>
              <image x="49" y="300" width="26" height="26" href="/brand/tools/instantly.webp" preserveAspectRatio="xMidYMid meet"></image>
              <text x="84" y="310" text-anchor="start" font-size="12" font-weight="700" fill="#262b32">Sequence</text>
              <text x="84" y="324" text-anchor="start" font-size="10" fill="#5e6671">Instantly</text>
            </g>
            <g class="hv-node">
              <rect x="246" y="288" width="158" height="52" rx="12" fill="#ffffff" stroke="#e5e1d4"></rect>
              <rect x="258" y="299" width="28" height="28" rx="6" fill="#f4f1ec"></rect>
              <image x="259" y="300" width="26" height="26" href="/brand/tools/pipedrive.svg" preserveAspectRatio="xMidYMid meet"></image>
              <text x="294" y="310" text-anchor="start" font-size="12" font-weight="700" fill="#262b32">Pipeline</text>
              <text x="294" y="324" text-anchor="start" font-size="10" fill="#5e6671">Pipedrive</text>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools we cover (logo strip): a single-row auto-scrolling marquee. The track
       renders stripTools TWICE back to back and animates translateX(-50%), which
       moves exactly one copy's width and loops seamlessly into the second (identical)
       copy. The second copy is aria-hidden + untabbable so screen readers and
       keyboard nav only ever see one real set of links. Speed is set in JS below
       from stripTools.length so the pace stays constant as tools are added. -->
  <section class="logo-strip-section">
    <div class="container--wide">
      <p class="logo-strip-label">Tools we cover</p>
    </div>
    <div class="logo-strip">
      <div class="logo-strip-track" style={`--marquee-duration:${Math.max(20, stripTools.length * 1.8)}s`}>
        {stripTools.map((tool) => (
          <a href={`/tools/${tool.slug}/`} class="logo-strip-item">
            {tool.logo && <img src={tool.logo} alt="" loading="lazy" decoding="async" />}
            <span class="logo-strip-name">{tool.name}</span>
          </a>
        ))}
        {stripTools.map((tool) => (
          <a href={`/tools/${tool.slug}/`} class="logo-strip-item" aria-hidden="true" tabindex="-1">
            {tool.logo && <img src={tool.logo} alt="" loading="lazy" decoding="async" />}
            <span class="logo-strip-name">{tool.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="section">
    <div class="container--wide">
      <p class="section-label">Latest from the blog</p>
      <h2 class="section-heading">Recent Articles</h2>

      {recentPosts.length > 0 ? (
        <div class="card-grid">
          {recentPosts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p style="color:var(--text-muted)">No posts yet, check back soon.</p>
      )}

      <div class="mt-lg">
        <a href="/blog/" class="btn btn--ghost">View all articles &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Editorial sections by format -->
  <section class="section section--divider">
    <div class="container--wide">
      {editorialSections.map((sec) => (
        <div class="format-block">
          <div class="format-block-head">
            <div>
              <h2 class="format-block-title">{sec.heading}</h2>
              <p class="format-block-dek">{sec.dek}</p>
            </div>
            <a href={sec.href} class="format-block-viewall">View all &rarr;</a>
          </div>
          {sec.posts.length > 0 ? (
            <div class="card-grid">
              {sec.posts.map((post) => <PostCard post={post} />)}
            </div>
          ) : (
            <p class="format-block-empty">More {sec.heading.toLowerCase()} on the way.</p>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Pricing-index band -->
  <section class="section section--divider section--tinted">
    <div class="container--wide">
      <p class="section-label">The site's linkable asset</p>
      <h2 class="section-heading">RevOps tool pricing, read from the vendor</h2>
      <p class="format-block-dek">
        {pricedTools.length} tools priced straight from their own pricing pages, published as a
        dataset you can download and cite. Updated {pricingIndex.generatedAt}, rebuilt quarterly
        (next ~2026-11-12).
      </p>
      <div class="stat-row" style={`--cols: ${pricingStats.length}`}>
        {pricingStats.map((stat) => (
          <div class="stat-card">
            <div class="stat-card-number">{stat.number}</div>
            <div class="stat-card-label">{stat.label}</div>
            <div class="stat-card-description">{stat.description}</div>
          </div>
        ))}
      </div>
      <div class="mt-lg">
        <a href="/revops-automation-pricing/" class="btn btn--ghost">View the full pricing index &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Start with your role -->
  <section class="section section--divider">
    <div class="container--wide">
      <p class="section-label">Pick your lane</p>
      <h2 class="section-heading">Start with your role</h2>
      <ul class="role-list">
        {audiences.map((a) => (
          <li class="role-list-item">
            <a href={`/teams/${a.slug}/`} class="role-list-link">
              <span class="role-list-name">{a.navLabel}</span>
              <span class="role-list-desc">{a.description}</span>
              <span class="role-list-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- From the author -->
  <section class="section section--divider">
    <div class="container--wide">
      <div class="author-block">
        <img
          src="/images/ian-headshot.jpg"
          alt="Ian Chamberland"
          class="author-block-photo"
          width="72"
          height="88"
          loading="lazy"
        />
        <p class="author-block-text">
          I'm Ian Chamberland, and I write everything on this site myself, mostly from RevOps and
          GTM stacks I have actually built or broken. Find me on
          <a href="https://www.linkedin.com/in/ianchamberland/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          or read <a href="/about/">the full story</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Email Signup -->
  <section id="newsletter" class="section section--divider section--anchor">
    <div class="container--wide">
      <EmailSignup />
    </div>
  </section>

</BaseLayout>
