---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { getCollection } from 'astro:content';
import { tools } from '../data/tools';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Topic tiles: most-used tags, with a post count, deep-linking into the blog filter.
// Lowercase the keys so case-variant duplicates ("HubSpot"/"hubspot") merge and
// the ?tag= link matches the blog filter (which also normalizes to lowercase).
const tagCounts = new Map<string, number>();
for (const p of allPosts) {
  for (const t of p.data.tags) {
    const k = t.toLowerCase();
    tagCounts.set(k, (tagCounts.get(k) ?? 0) + 1);
  }
}
// "guide" and "tools" are meta-tags describing the content type, not a topic —
// drop them so the tile set is all real subject matter.
const topicTiles = [...tagCounts.entries()]
  .filter(([tag]) => tag !== 'guide' && tag !== 'tools')
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);

// "Tools we cover" strip: dedupe by slug, stable order from the registry.
// Only listed tools appear here; pipeline tools (listed:false) still get a hub page.
const stripTools = tools.filter((t) => t.listed !== false);

// Editorial casing for topic tiles — CSS text-transform:capitalize breaks
// brand casing (HubSpot -> Hubspot, n8n -> N8n), so map it explicitly.
const topicLabelMap: Record<string, string> = {
  crm: 'CRM',
  hubspot: 'HubSpot',
  revops: 'RevOps',
  ai: 'AI',
  n8n: 'n8n',
  saas: 'SaaS',
};
function topicLabel(tag: string): string {
  if (topicLabelMap[tag]) return topicLabelMap[tag];
  return tag.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}
---

<BaseLayout
  title="The Automations Guide"
  description="The RevOps and GTM automation playbook: honest tool reviews, copy-paste workflows, and revenue operations strategy for go-to-market teams."
>
  <!-- Hero (split: copy + workflow visual) -->
  <section class="hero hero--split">
    <div class="container--wide">
      <div class="hero-split">
        <div class="hero-copy">
          <div class="hero-eyebrow">RevOps &middot; GTM &middot; Automation</div>
          <h1>The RevOps &amp; GTM automation playbook.</h1>
          <p>
            Honest tool reviews, copy-paste workflows, and revenue operations
            strategy for go-to-market teams that want to scale output, not headcount.
          </p>
          <div class="hero-actions">
            <a href="/blog/" class="btn btn--primary">Read the Blog &rarr;</a>
            <a href="/tools/" class="btn btn--ghost">Browse Tools</a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <svg viewBox="0 0 440 360" role="presentation" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <marker id="hv-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" fill="#cdc7b3"></path>
              </marker>
            </defs>
            <!-- connectors: equal 82px gaps between rows, S-curves end at top-center of dest node -->
            <g fill="none" stroke="#cdc7b3" stroke-width="2" marker-end="url(#hv-arrow)">
              <path d="M150 46 C200 46 200 46 246 46"></path>
              <path d="M325 72 C325 113 93 113 93 154"></path>
              <path d="M150 180 C200 180 200 180 246 180"></path>
              <path d="M325 206 C325 247 93 247 93 288"></path>
              <path d="M150 314 C200 314 230 314 246 314"></path>
            </g>
            <!-- accent flow dots at midpoint of each horizontal connector -->
            <g fill="#14a890">
              <circle cx="200" cy="46" r="3.5"></circle>
              <circle cx="200" cy="180" r="3.5"></circle>
              <circle cx="200" cy="314" r="3.5"></circle>
            </g>
            <!-- nodes: tool logo (26x26 in rounded bg card, text to right) -->
            <!-- Row 1: n8n Trigger → Clay Enrich -->
            <g class="hv-node">
              <rect x="36" y="20" width="114" height="52" rx="12" fill="#ffffff" stroke="#e5e1d4"></rect>
              <rect x="48" y="31" width="28" height="28" rx="6" fill="#f4f1ec"></rect>
              <image x="49" y="32" width="26" height="26" href="/brand/tools/n8n.svg" preserveAspectRatio="xMidYMid meet"></image>
              <text x="84" y="42" text-anchor="start" font-size="12" font-weight="700" fill="#262b32">Trigger</text>
              <text x="84" y="56" text-anchor="start" font-size="10" fill="#5e6671">n8n</text>
            </g>
            <g class="hv-node">
              <rect x="246" y="20" width="158" height="52" rx="12" fill="#ffffff" stroke="#e5e1d4"></rect>
              <rect x="258" y="31" width="28" height="28" rx="6" fill="#f4f1ec"></rect>
              <image x="259" y="32" width="26" height="26" href="/brand/tools/clay.webp" preserveAspectRatio="xMidYMid meet"></image>
              <text x="294" y="42" text-anchor="start" font-size="12" font-weight="700" fill="#262b32">Enrich</text>
              <text x="294" y="56" text-anchor="start" font-size="10" fill="#5e6671">Clay</text>
            </g>
            <!-- Row 2: Apollo Qualify → HubSpot Sync to CRM -->
            <g class="hv-node">
              <rect x="36" y="154" width="114" height="52" rx="12" fill="#ffffff" stroke="#e5e1d4"></rect>
              <rect x="48" y="165" width="28" height="28" rx="6" fill="#f4f1ec"></rect>
              <image x="49" y="166" width="26" height="26" href="/brand/tools/apollo.svg" preserveAspectRatio="xMidYMid meet"></image>
              <text x="84" y="176" text-anchor="start" font-size="12" font-weight="700" fill="#262b32">Qualify</text>
              <text x="84" y="190" text-anchor="start" font-size="10" fill="#5e6671">Apollo</text>
            </g>
            <g class="hv-node">
              <rect x="246" y="154" width="158" height="52" rx="12" fill="#14a890" stroke="#14a890"></rect>
              <rect x="258" y="165" width="28" height="28" rx="6" fill="rgba(255,255,255,0.9)"></rect>
              <image x="259" y="166" width="26" height="26" href="/brand/tools/hubspot.svg" preserveAspectRatio="xMidYMid meet"></image>
              <text x="294" y="176" text-anchor="start" font-size="12" font-weight="700" fill="#ffffff">Sync to CRM</text>
              <text x="294" y="190" text-anchor="start" font-size="10" fill="#e6fbf6">HubSpot</text>
            </g>
            <!-- Row 3: Instantly Sequence → Pipedrive Pipeline -->
            <g class="hv-node">
              <rect x="36" y="288" width="114" height="52" rx="12" fill="#ffffff" stroke="#e5e1d4"></rect>
              <rect x="48" y="299" width="28" height="28" rx="6" fill="#f4f1ec"></rect>
              <image x="49" y="300" width="26" height="26" href="/brand/tools/instantly.webp" preserveAspectRatio="xMidYMid meet"></image>
              <text x="84" y="310" text-anchor="start" font-size="12" font-weight="700" fill="#262b32">Sequence</text>
              <text x="84" y="324" text-anchor="start" font-size="10" fill="#5e6671">Instantly</text>
            </g>
            <g class="hv-node">
              <rect x="246" y="288" width="158" height="52" rx="12" fill="#ffffff" stroke="#e5e1d4"></rect>
              <rect x="258" y="299" width="28" height="28" rx="6" fill="#f4f1ec"></rect>
              <image x="259" y="300" width="26" height="26" href="/brand/tools/pipedrive.svg" preserveAspectRatio="xMidYMid meet"></image>
              <text x="294" y="310" text-anchor="start" font-size="12" font-weight="700" fill="#262b32">Pipeline</text>
              <text x="294" y="324" text-anchor="start" font-size="10" fill="#5e6671">Pipedrive</text>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools we cover (logo strip): a single-row auto-scrolling marquee. The track
       renders stripTools TWICE back to back and animates translateX(-50%), which
       moves exactly one copy's width and loops seamlessly into the second (identical)
       copy. The second copy is aria-hidden + untabbable so screen readers and
       keyboard nav only ever see one real set of links. Speed is set in JS below
       from stripTools.length so the pace stays constant as tools are added. -->
  <section class="logo-strip-section">
    <div class="container--wide">
      <p class="logo-strip-label">Tools we cover</p>
    </div>
    <div class="logo-strip">
      <div class="logo-strip-track" style={`--marquee-duration:${Math.max(20, stripTools.length * 1.8)}s`}>
        {stripTools.map((tool) => (
          <a href={`/tools/${tool.slug}/`} class="logo-strip-item">
            {tool.logo && <img src={tool.logo} alt="" loading="lazy" decoding="async" />}
            <span class="logo-strip-name">{tool.name}</span>
          </a>
        ))}
        {stripTools.map((tool) => (
          <a href={`/tools/${tool.slug}/`} class="logo-strip-item" aria-hidden="true" tabindex="-1">
            {tool.logo && <img src={tool.logo} alt="" loading="lazy" decoding="async" />}
            <span class="logo-strip-name">{tool.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="section">
    <div class="container--wide">
      <p class="section-label">Latest from the blog</p>
      <h2 class="section-heading">Recent Articles</h2>

      {recentPosts.length > 0 ? (
        <div class="card-grid">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="post-card">
              {post.data.tags.length > 0 && (
                <div class="post-card-tags">
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <div class="post-card-meta">
                <span>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p style="color:var(--text-muted)">No posts yet, check back soon.</p>
      )}

      <div class="mt-lg">
        <a href="/blog/" class="btn btn--ghost">View all articles &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Browse by topic -->
  {topicTiles.length > 0 && (
    <section class="section" style="border-top:1px solid var(--border);background:var(--bg-secondary);">
      <div class="container--wide">
        <p class="section-label">Find what you need</p>
        <h2 class="section-heading">Browse by topic</h2>
        <div class="topic-tiles">
          {topicTiles.map(([tag, count]) => (
            <a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="topic-tile">
              <span class="topic-tile-body">
                <span class="topic-tile-name">{topicLabel(tag)}</span>
                <span class="topic-tile-count">{count} article{count === 1 ? '' : 's'}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Email Signup -->
  <section id="newsletter" class="section" style="border-top:1px solid var(--border);scroll-margin-top:calc(var(--nav-h) + 1rem);">
    <div class="container--wide">
      <EmailSignup />
    </div>
  </section>

</BaseLayout>
