---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { tools, toolCategories, categorySubs, categoryAnchor, postMentionsTool } from '../data/tools';

// Build-time guard: a tool whose category is not a rendered section would never
// appear in the grid below (18 listed tools were silently dropped that way until
// 2026-10-01). Fail the build instead. qa:lint (A3c) checks the same rule earlier.
const uncategorized = tools.filter((t) => !toolCategories.includes(t.category));
if (uncategorized.length) {
  throw new Error(`tools.ts: category not in toolCategories for ${uncategorized.map((t) => `${t.slug} ("${t.category}")`).join(', ')}`);
}
const sections = toolCategories
  .map((category) => ({ category, items: tools.filter((t) => t.category === category && t.listed !== false) }))
  .filter((s) => s.items.length > 0);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const articleCount = (slug: string) => {
  const tool = tools.find((t) => t.slug === slug)!;
  return allPosts.filter((post) => postMentionsTool(tool, post)).length;
};
---

<BaseLayout
  title="Automation Tools for RevOps & GTM Teams"
  description="The best automation, CRM, outbound, and newsletter tools for RevOps and GTM teams, tested and reviewed by an 8-year RevOps practitioner."
>
  <!-- Affiliate disclosure -->
  <div class="container--wide" style="padding-top:2rem;">
    <div class="affiliate-notice">
      <strong>Affiliate Disclosure:</strong> Some links on this page are affiliate links. If you sign up or purchase through them, we earn a commission at no extra cost to you. We only list tools we'd genuinely recommend to a fellow RevOps practitioner. Our editorial opinions are not influenced by affiliate relationships. <a href="/disclosure/">Read the full disclosure</a>.
    </div>
  </div>

  <!-- Hero -->
  <section class="tools-hero">
    <div class="container--wide">
      <div class="hero-eyebrow">Tools &middot; Reviews &middot; Recommendations</div>
      <h1>The RevOps automation stack, tested and reviewed</h1>
      <p>
        Curated picks across workflow automation, CRM, outbound, and newsletter, with honest
        takes on where each tool fits and when to use it. Every tool here has been used in a
        real GTM stack.
      </p>
      <p class="tools-hero-aside">
        Comparing on cost? The <a href="/revops-automation-pricing/">RevOps pricing index</a> lists
        entry price, free tier, and billing unit for every tool here, each read from the vendor's
        own pricing page and dated.
      </p>
    </div>
  </section>

  {sections.map(({ category, items }, i) => (
    <section class="section tools-cat-section" id={categoryAnchor(category)} style={i > 0 ? 'border-top:1px solid var(--border);' : undefined}>
      <div class="container--wide">
        <div class="tools-category">
          <h2 class="tools-category-heading">{category}</h2>
          {categorySubs[category] && <p class="tools-category-sub">{categorySubs[category]}</p>}
        </div>
        <div class="tool-grid">
          {items.map((tool) => {
            const count = articleCount(tool.slug);
            return (
              <div class="tool-card">
                <div class="tool-card-logo-slot">
                  {tool.logo ? (
                    <img class="tool-card-logo" src={tool.logo} alt={`${tool.name} logo`} loading="lazy" decoding="async" />
                  ) : (
                    <span class="tool-card-logo-text">{tool.name}</span>
                  )}
                </div>
                <div class="tool-card-header">
                  <h3><a class="tool-card-title-link" href={`/tools/${tool.slug}/`}>{tool.name}</a></h3>
                  <span class={`tool-badge${tool.badgeFree ? ' tool-badge--free' : ''}`}>{tool.badge}</span>
                </div>
                <p>{tool.blurb}</p>
                <div class="tool-card-actions">
                  <a
                    href={`/go/${tool.slug}/`}
                    class={`btn ${tool.ctaPrimary ? 'btn--primary' : 'btn--ghost'}`}
                    target="_blank"
                    rel="noopener noreferrer sponsored"
                  >
                    {tool.ctaLabel} &rarr;
                  </a>
                  {count > 0 && (
                    <a href={`/tools/${tool.slug}/`} class="tool-articles-link">
                      {count} article{count === 1 ? '' : 's'} &rarr;
                    </a>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  {/* Full A-Z index of every tool guide. The category grid above only renders
      listed (promoted) tools, so the pipeline hubs (listed:false) had no
      internal link anywhere except the sitemap and were never crawled
      ("URL is unknown to Google" in GSC). Linking every hub from this indexed
      page gives Googlebot a crawl path to all of them. Neutral text links, not
      promoted cards, so it doesn't change which tools are featured above. */}
  <section class="section section--divider section--tinted">
    <div class="container--wide">
      <div class="tools-category">
        <h2 class="tools-category-heading">Every tool we cover</h2>
        <p class="tools-category-sub">The full library of tool guides, including ones we're still evaluating.</p>
      </div>
      <ul class="tool-index">
        {[...tools]
          .sort((a, b) => a.name.localeCompare(b.name))
          .map((tool) => (
            <li><a href={`/tools/${tool.slug}/`}>{tool.name}</a></li>
          ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* Offset anchor jumps (from the header "Tools" dropdown) so the sticky nav
     doesn't cover the category heading. */
  .tools-cat-section { scroll-margin-top: calc(var(--nav-h) + 0.5rem); }
  .tool-card h3 a { color: inherit; text-decoration: none; }
  .tool-card h3 a:hover { color: var(--accent); }
  /* Whole card is a single click target for the tool's hub page. The title
     link's ::after stretches over the entire (position:relative) card, so a
     click anywhere on the card navigates to /tools/<slug> without nesting
     anchors. Inner interactive elements (Try CTA, article link) are lifted
     above the cover with z-index so they stay independently clickable. */
  .tool-card-title-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }
  .tool-card:hover h3 a { color: var(--accent); }
  .tool-card-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    /* Pin the CTA + article-link block to the bottom of every card, at a fixed
       height, so buttons line up across a category row regardless of blurb
       length, button-label length, or whether the optional article link is
       present. Row layout used to wrap the article link onto its own line
       whenever the button text was long enough to fill the card width, which
       made that card's block one line taller and pushed its button above the
       row's other buttons. Stacking removes the wrap that caused it. */
    margin-top: auto;
    min-height: 4rem;
  }
  .tool-card-actions > * {
    position: relative;
    z-index: 1;
  }
  .tool-articles-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .tool-articles-link:hover { color: var(--accent); text-decoration: none; }
  /* A-Z index of every tool guide (internal-link path to all hubs). */
  .tool-index {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 0.5rem 1.5rem;
  }
  .tool-index a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .tool-index a:hover { color: var(--accent); text-decoration: underline; }

  /* Sits under the hero copy, deliberately quieter than it: a pointer to the data
     asset, not a competing headline. */
  .tools-hero-aside {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--text-muted, #5b6472);
    border-left: 3px solid var(--accent, #14a890);
    padding-left: 0.85rem;
  }
</style>
