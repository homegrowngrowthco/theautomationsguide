---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Automation Tools for RevOps & GTM Teams"
  description="The best automation, CRM, outbound, and newsletter tools for RevOps and GTM teams — tested and reviewed by an 8-year RevOps practitioner."
>
  <!-- Affiliate disclosure -->
  <div class="container--wide" style="padding-top:2rem;">
    <div class="affiliate-notice">
      <strong>Affiliate Disclosure:</strong> Some links on this page are affiliate links. If you sign up or purchase through them, we earn a commission at no extra cost to you. We only list tools we'd genuinely recommend to a fellow RevOps practitioner — our editorial opinions are not influenced by affiliate relationships. <a href="/disclosure">Read the full disclosure</a>.
    </div>
  </div>

  <!-- Hero -->
  <section class="tools-hero">
    <div class="container">
      <div class="hero-eyebrow">Tools &middot; Reviews &middot; Recommendations</div>
      <h1>The RevOps automation stack — tested and reviewed</h1>
      <p>
        Curated picks across workflow automation, CRM, outbound, and newsletter — with honest
        takes on where each tool fits and when to use it. Every tool here has been used in a
        real GTM stack.
      </p>
    </div>
  </section>

  <!-- Workflow Automation -->
  <section class="section">
    <div class="container--wide">
      <div class="tools-category">
        <h2 class="tools-category-heading">Workflow Automation</h2>
        <p class="tools-category-sub">The middleware layer that connects your stack and runs your GTM playbooks.</p>
      </div>
      <div class="tool-grid">

        <div class="tool-card">
          <div class="tool-card-header">
            <h3>Make</h3>
            <span class="tool-badge tool-badge--free">Free tier available</span>
          </div>
          <p>
            Make (formerly Integromat) is the best-in-class automation platform for RevOps teams
            that need complex logic, data transformation, and multi-path workflows. More powerful
            than Zapier at a fraction of the cost, with a visual canvas that makes it easy to
            reason about even the most complex flows.
          </p>
          <a href="/go/make" class="btn btn--primary tool-cta" target="_blank" rel="noopener noreferrer sponsored">
            Try Make &rarr;
          </a>
        </div>

        <div class="tool-card">
          <div class="tool-card-header">
            <h3>n8n</h3>
            <span class="tool-badge tool-badge--free">Free (self-hosted) or Cloud</span>
          </div>
          <p>
            n8n is an open-source workflow automation tool you can self-host for full data control
            and no per-operation pricing. It's ideal for engineering-forward GTM teams that want
            Make-level power without ongoing platform costs — or for teams that want a managed
            cloud option.
          </p>
          <a href="/go/n8n" class="btn btn--ghost tool-cta" target="_blank" rel="noopener noreferrer sponsored">
            Explore n8n &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- CRM -->
  <section class="section" style="border-top:1px solid var(--border);">
    <div class="container--wide">
      <div class="tools-category">
        <h2 class="tools-category-heading">CRM</h2>
        <p class="tools-category-sub">The system of record at the center of your GTM motion.</p>
      </div>
      <div class="tool-grid">

        <div class="tool-card">
          <div class="tool-card-header">
            <h3>HubSpot</h3>
            <span class="tool-badge tool-badge--free">Free tier available</span>
          </div>
          <p>
            HubSpot is the CRM at the center of most modern GTM stacks, with built-in workflow
            automation that handles lead routing, deal stage triggers, and sequences out of the box.
            The free tier is genuinely useful; paid tiers unlock the automation depth RevOps teams
            actually need.
          </p>
          <a href="/go/hubspot" class="btn btn--primary tool-cta" target="_blank" rel="noopener noreferrer sponsored">
            Try HubSpot &rarr;
          </a>
        </div>

        <div class="tool-card">
          <div class="tool-card-header">
            <h3>Pipedrive</h3>
            <span class="tool-badge tool-badge--free">14-day free trial</span>
          </div>
          <p>
            Pipedrive is the CRM HubSpot-skeptics pick. Lighter, sales-pipeline-first, with
            cleaner pricing at scale. Strong fit for SMB GTM teams that find HubSpot's free
            tier limiting but its paid tiers overpriced for what they actually use.
          </p>
          <a href="/go/pipedrive" class="btn btn--ghost tool-cta" target="_blank" rel="noopener noreferrer sponsored">
            Try Pipedrive &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Outbound & Lead Gen -->
  <section class="section" style="border-top:1px solid var(--border);">
    <div class="container--wide">
      <div class="tools-category">
        <h2 class="tools-category-heading">Outbound &amp; Lead Generation</h2>
        <p class="tools-category-sub">Enrichment, contact data, and cold email tools that fill the top of your funnel.</p>
      </div>
      <div class="tool-grid">

        <div class="tool-card">
          <div class="tool-card-header">
            <h3>Clay</h3>
            <span class="tool-badge">Paid</span>
          </div>
          <p>
            Clay combines a spreadsheet interface with 50+ enrichment data sources to help you
            build targeted, personalized outbound lists at scale. If your SDR team is manually
            researching accounts, Clay is the highest-leverage tool you're probably not using yet.
          </p>
          <a href="/go/clay" class="btn btn--primary tool-cta" target="_blank" rel="noopener noreferrer sponsored">
            Try Clay &rarr;
          </a>
        </div>

        <div class="tool-card">
          <div class="tool-card-header">
            <h3>Apollo.io</h3>
            <span class="tool-badge tool-badge--free">Free tier available</span>
          </div>
          <p>
            Apollo combines a 275M+ contact database with built-in email sequencing, making it a
            one-stop shop for outbound GTM teams. The enrichment API also integrates cleanly with
            HubSpot for keeping CRM data current without manual data entry.
          </p>
          <a href="/go/apollo" class="btn btn--ghost tool-cta" target="_blank" rel="noopener noreferrer sponsored">
            Try Apollo &rarr;
          </a>
        </div>

        <div class="tool-card">
          <div class="tool-card-header">
            <h3>Smartlead</h3>
            <span class="tool-badge">Paid</span>
          </div>
          <p>
            Smartlead is the cold email infrastructure RevOps teams actually use at scale —
            unlimited inboxes, built-in warmup, and pricing that doesn't punish you for sending
            volume. The right tool when you've outgrown Apollo's sequencer or Lemlist's caps.
          </p>
          <a href="/go/smartlead" class="btn btn--ghost tool-cta" target="_blank" rel="noopener noreferrer sponsored">
            Try Smartlead &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section" style="border-top:1px solid var(--border);">
    <div class="container--wide">
      <div class="tools-category">
        <h2 class="tools-category-heading">Newsletter Platform</h2>
        <p class="tools-category-sub">The tool we use to publish — and recommend to anyone serious about owned audience.</p>
      </div>
      <div class="tool-grid">

        <div class="tool-card">
          <div class="tool-card-header">
            <h3>Beehiiv</h3>
            <span class="tool-badge tool-badge--free">Free up to 2,500 subs</span>
          </div>
          <p>
            Beehiiv is the newsletter platform built specifically for serious publishers — strong
            free tier, native referral programs, paid subscriptions, and built-in monetization via
            Boosts. We use it to publish The Automations Guide; it's the tool we'd pick again.
          </p>
          <a href="/go/beehiiv" class="btn btn--primary tool-cta" target="_blank" rel="noopener noreferrer sponsored">
            Try Beehiiv &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
