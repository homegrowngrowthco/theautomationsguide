---
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/ui/Band.astro';
import Container from '../components/ui/Container.astro';
import { getCollection } from 'astro:content';
import { tools, toolCategories, categorySubs, categoryAnchor, postMentionsTool } from '../data/tools';

// Build-time guard: a tool whose category is not a rendered section would never
// appear in the grid below (18 listed tools were silently dropped that way until
// 2026-10-01). Fail the build instead. qa:lint (A3c) checks the same rule earlier.
const uncategorized = tools.filter((t) => !toolCategories.includes(t.category));
if (uncategorized.length) {
  throw new Error(`tools.ts: category not in toolCategories for ${uncategorized.map((t) => `${t.slug} ("${t.category}")`).join(', ')}`);
}
const sections = toolCategories
  .map((category) => ({ category, items: tools.filter((t) => t.category === category && t.listed !== false) }))
  .filter((s) => s.items.length > 0);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const articleCount = (slug: string) => {
  const tool = tools.find((t) => t.slug === slug)!;
  return allPosts.filter((post) => postMentionsTool(tool, post)).length;
};
---

<BaseLayout
  title="Automation Tools for RevOps & GTM Teams"
  description="The best automation, CRM, outbound, and newsletter tools for RevOps and GTM teams, chosen by an 8-year RevOps practitioner, with prices read from each vendor's own page."
>
  <!-- Hero: the ink frame (design program 2026-10) -->
  <Band class="tools-band">
    <Container size="wide">
      <p class="tools-eyebrow">{sections.reduce((n, s) => n + s.items.length, 0)} tools in {sections.length} categories</p>
      <h1>The RevOps automation stack, by job</h1>
      <p class="tools-lede">
        Curated picks across workflow automation, CRM, outbound and newsletters, with where each tool
        fits and when to use it. Comparing on cost? The <a href="/revops-automation-pricing/">RevOps pricing index</a>
        lists entry price, free tier and billing unit for every tool here, each read from the vendor's own
        pricing page and dated.
      </p>
      <nav class="tools-jump" aria-label="Jump to a category">
        {sections.map(({ category }) => <a href={`#${categoryAnchor(category)}`}>{category}</a>)}
      </nav>
    </Container>
  </Band>
  <div class="container--wide">
    <p class="tools-disclosure">
      Some links on this page are affiliate links. If you buy through them we may earn a commission at no cost
      to you; it never changes what we list. <a href="/disclosure/">Every program, by name</a>.
    </p>
  </div>

  {sections.map(({ category, items }, i) => (
    <section class="section tools-cat-section" id={categoryAnchor(category)} style={i > 0 ? 'border-top:1px solid var(--border);' : undefined}>
      <div class="container--wide">
        <div class="tools-category">
          <h2 class="tools-category-heading">{category}</h2>
          {categorySubs[category] && <p class="tools-category-sub">{categorySubs[category]}</p>}
        </div>
        <div class="tool-grid">
          {items.map((tool) => {
            const count = articleCount(tool.slug);
            return (
              <div class="tool-card">
                <div class="tool-card-logo-slot">
                  {tool.logo ? (
                    <img class="tool-card-logo" src={tool.logo} alt={`${tool.name} logo`} loading="lazy" decoding="async" />
                  ) : (
                    <span class="tool-card-logo-text">{tool.name}</span>
                  )}
                </div>
                <div class="tool-card-header">
                  <h3><a class="tool-card-title-link" href={`/tools/${tool.slug}/`}>{tool.name}</a></h3>
                  <span class={`tool-badge${tool.badgeFree ? ' tool-badge--free' : ''}`}>{tool.badge}</span>
                </div>
                <p>{tool.blurb}</p>
                <div class="tool-card-actions">
                  <a
                    href={`/go/${tool.slug}/`}
                    class={`btn ${tool.ctaPrimary ? 'btn--primary' : 'btn--ghost'}`}
                    target="_blank"
                    rel="noopener noreferrer sponsored"
                  >
                    {tool.ctaLabel} &rarr;
                  </a>
                  {count > 0 && (
                    <a href={`/tools/${tool.slug}/`} class="tool-articles-link">
                      {count} article{count === 1 ? '' : 's'} &rarr;
                    </a>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  {/* Full A-Z index of every tool guide. The category grid above only renders
      listed (promoted) tools, so the pipeline hubs (listed:false) had no
      internal link anywhere except the sitemap and were never crawled
      ("URL is unknown to Google" in GSC). Linking every hub from this indexed
      page gives Googlebot a crawl path to all of them. Neutral text links, not
      promoted cards, so it doesn't change which tools are featured above. */}
  <section class="section section--divider section--tinted">
    <div class="container--wide">
      <div class="tools-category">
        <h2 class="tools-category-heading">Every tool we cover</h2>
        <p class="tools-category-sub">The full library of tool guides, including ones we're still evaluating.</p>
      </div>
      <ul class="tool-index">
        {[...tools]
          .sort((a, b) => a.name.localeCompare(b.name))
          .map((tool) => (
            <li><a href={`/tools/${tool.slug}/`}>{tool.name}</a></li>
          ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* Offset anchor jumps (from the header "Tools" dropdown) so the sticky nav
     doesn't cover the category heading. */
  .tools-cat-section { scroll-margin-top: calc(var(--nav-h) + 0.5rem); }
  .tool-card h3 a { color: inherit; text-decoration: none; }
  .tool-card h3 a:hover { color: var(--accent-text); }
  /* Whole card is a single click target for the tool's hub page. The title
     link's ::after stretches over the entire (position:relative) card, so a
     click anywhere on the card navigates to /tools/<slug> without nesting
     anchors. Inner interactive elements (Try CTA, article link) are lifted
     above the cover with z-index so they stay independently clickable. */
  .tool-card-title-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }
  .tool-card:hover h3 a { color: var(--accent-text); }
  .tool-card-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    /* Pin the CTA + article-link block to the bottom of every card, at a fixed
       height, so buttons line up across a category row regardless of blurb
       length, button-label length, or whether the optional article link is
       present. Row layout used to wrap the article link onto its own line
       whenever the button text was long enough to fill the card width, which
       made that card's block one line taller and pushed its button above the
       row's other buttons. Stacking removes the wrap that caused it. */
    margin-top: auto;
    min-height: 4rem;
  }
  .tool-card-actions > * {
    position: relative;
    z-index: 1;
  }
  .tool-articles-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .tool-articles-link:hover { color: var(--accent-text); text-decoration: none; }
  /* A-Z index of every tool guide (internal-link path to all hubs). */
  .tool-index {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 0.5rem 1.5rem;
  }
  .tool-index a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .tool-index a:hover { color: var(--accent-text); text-decoration: underline; }

  /* ── 2026-10 ("Ink spec") ── */
  :global(.tools-band) { padding: 2.75rem 0 2.5rem; }
  .tools-eyebrow { margin: 0 0 0.9rem; font: 600 0.8rem/1 var(--font-sans); letter-spacing: 0.07em; text-transform: uppercase; color: var(--band-accent); }
  :global(.tools-band) h1 { margin: 0 0 0.9rem; color: #fff; font: 600 clamp(2rem, 4vw, var(--step-6))/1.1 var(--font-serif); letter-spacing: -0.02em; }
  .tools-lede { margin: 0 0 1.5rem; max-width: 72ch; font: 400 var(--step-1)/1.6 var(--font-sans); color: var(--band-muted); }
  .tools-lede a { text-decoration: underline; text-underline-offset: 2px; }
  .tools-jump { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  /* Phones: one row that scrolls inside itself instead of a screen of chips. */
  @media (max-width: 720px) {
    .tools-jump { flex-wrap: nowrap; overflow-x: auto; margin: 0 -1rem; padding: 0 1rem 0.25rem; scrollbar-width: none; }
    .tools-jump a { flex: none; }
  }
  .tools-jump a { display: inline-flex; align-items: center; min-height: 36px; padding: 0.35rem 0.75rem; border: 1px solid var(--band-line); border-radius: var(--radius-sm); font: 500 0.85rem var(--font-sans); color: var(--band-muted) !important; text-decoration: none; }
  .tools-jump a:hover { border-color: rgba(255, 255, 255, 0.4); color: #fff !important; }
  .tools-disclosure { margin: 1rem 0 0; font: 400 0.85rem/1.5 var(--font-sans); color: var(--text-muted); }
  .tools-disclosure a { color: var(--accent-text); text-decoration: underline; text-underline-offset: 2px; }
  .tools-category-heading { font: 600 var(--step-4)/1.2 var(--font-serif) !important; letter-spacing: -0.015em; color: var(--ink-900); }
  .tool-card { background: var(--bg-card); border-color: var(--border); border-radius: var(--radius-md); min-width: 0; }
  .tool-card:hover { border-color: var(--ink-300); }
  .tool-card-title-link::after { border-radius: var(--radius-md); }
  /* Consistent cards: the blurb holds three lines; the full text is on the hub. */
  .tool-card > p { display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .tool-articles-link { color: var(--ink-600); }
</style>
