---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ItemListSchema from '../components/ItemListSchema.astro';
import PageHead from '../components/ui/PageHead.astro';
import Container from '../components/ui/Container.astro';
import { getCollection } from 'astro:content';

// "Playbooks" = the step-by-step / how-to content (guides, tutorials, workflows),
// as opposed to the comparison-led head-to-heads (which live under
// /guides/tool-vs-tool/) or single-tool reviews (/reviews/).
const PLAYBOOK_TAGS = ['guide', 'tutorial', 'workflow', 'playbook'];

const all = await getCollection('blog', ({ data }) => !data.draft);
const posts = all
  .filter((p) => p.data.tags.some((t) => PLAYBOOK_TAGS.includes(t.toLowerCase())))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="RevOps & GTM Automation Playbooks"
  description="Step-by-step automation playbooks and workflow guides for RevOps and GTM teams, from operators who have shipped them."
>
  <PageHead
    eyebrow={`Playbooks · ${posts.length} articles`}
    title="Playbooks"
    lede="Step-by-step automation playbooks and workflow guides you can ship this week, not vendor theory."
  />
  <div class="listing-main"><Container size="wide">

    {posts.length > 0 ? (
      <div class="card-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <div class="empty-state">
        <p>Playbooks are on the way. <a href="/blog/">Browse all articles</a>.</p>
      </div>
    )}
  </Container></div>
  <ItemListSchema name="RevOps & GTM Automation Playbooks" items={posts.map((p) => ({ url: `/blog/${p.slug}/`, name: p.data.title }))} />
</BaseLayout>
