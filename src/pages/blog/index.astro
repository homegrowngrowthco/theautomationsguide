---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Every distinct tag (lowercased) for the "Filter by Topic" dropdown.
const allTags = [...new Set(posts.flatMap((p) => p.data.tags.map((t) => t.toLowerCase())))].sort();

// Pillar buttons map a label to a GROUP of topic tags (OR-matched). Single tags
// under-match (e.g. the `crm` tag is on ~1 post while CRM content is tagged
// hubspot/pipedrive/salesforce), so each pillar spans the related tags. The full
// tag list still lives in the dropdown for granular filtering.
const pillars = [
  { label: 'Cold Email', tags: ['cold-email', 'cold-outbound', 'outbound', 'sales-engagement', 'apollo', 'outreach-platform-criticism'] },
  { label: 'CRM', tags: ['crm', 'hubspot', 'salesforce', 'sales-ops', 'pipeline-data-quality'] },
  { label: 'Workflow Automation', tags: ['workflow', 'workflow-tools', 'make', 'zapier'] },
  { label: 'Lead Enrichment', tags: ['lead-enrichment', 'apollo', 'clay'] },
  { label: 'Newsletter', tags: ['newsletter', 'email-marketing', 'email', 'creators'] },
];
---

<BaseLayout
  title="RevOps & GTM Automation Blog"
  description="Actionable guides, software reviews, and workflow playbooks for scaling revenue teams. RevOps and GTM automation from operators who have shipped it."
>
  <div class="container--wide">
    <div class="page-header">
      <h1>The RevOps &amp; GTM Automation Blog</h1>
      <p>Actionable guides, software reviews, and workflow playbooks for scaling revenue teams.</p>

      <form class="nav-search blog-search" action="/search/" method="get" role="search" aria-label="Search posts">
        <span class="nav-search-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input type="search" name="q" placeholder="Search posts..." aria-label="Search posts and tools" autocomplete="off" />
      </form>

      <div class="tag-filter" role="group" aria-label="Filter posts by topic">
        <button type="button" class="tag tag--filter" data-group="__all__" aria-pressed="true">All</button>
        {pillars.map((p) => (
          <button type="button" class="tag tag--filter" data-group={p.tags.join(' ')} aria-pressed="false">{p.label}</button>
        ))}
        {allTags.length > 0 && (
          <select class="topic-select-input" aria-label="Filter by topic">
            <option value="__all__">Filter by topic</option>
            {allTags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
        )}
      </div>

      <p class="tag-filter-count" aria-live="polite" data-total={posts.length}></p>
    </div>

    {posts.length > 0 ? (
      <div class="card-grid" id="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <div style="text-align:center;padding:5rem 0;color:var(--text-muted);">
        <p style="font-size:1.125rem;">No posts yet, check back soon.</p>
      </div>
    )}

    <p class="tag-filter-empty" hidden>No posts match that topic yet. <button type="button" class="link-button" data-tag-reset>Show all posts</button>.</p>
  </div>

  <script is:inline>
    (function () {
      var buttons = Array.prototype.slice.call(document.querySelectorAll('.tag--filter'));
      var select = document.querySelector('.topic-select-input');
      var cards = Array.prototype.slice.call(document.querySelectorAll('#post-grid .post-card'));
      var countEl = document.querySelector('.tag-filter-count');
      var emptyEl = document.querySelector('.tag-filter-empty');
      if (!cards.length) return;
      var total = cards.length;
      var allBtn = null;
      buttons.forEach(function (b) { if (b.getAttribute('data-group') === '__all__') allBtn = b; });

      function setCount(n, label) {
        if (!countEl) return;
        countEl.textContent = label
          ? 'Showing ' + n + ' of ' + total + ' articles in ' + label
          : 'Showing all ' + total + ' articles';
        if (emptyEl) emptyEl.hidden = n !== 0;
      }

      // tags: array of lowercased tags to OR-match, or null for "all".
      function render(tags, label, urlTag) {
        var visible = 0;
        cards.forEach(function (card) {
          var cardTags = (card.getAttribute('data-tags') || '').split('|');
          var show = !tags || tags.some(function (t) { return cardTags.indexOf(t) !== -1; });
          card.hidden = !show;
          if (show) visible++;
        });
        setCount(visible, label);
        var url = urlTag
          ? window.location.pathname + '?tag=' + encodeURIComponent(urlTag)
          : window.location.pathname;
        history.replaceState(null, '', url);
      }

      function showAll() {
        buttons.forEach(function (b) { b.setAttribute('aria-pressed', b === allBtn ? 'true' : 'false'); });
        if (select) select.value = '__all__';
        render(null, null, null);
      }

      function showPillar(btn) {
        buttons.forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
        if (select) select.value = '__all__';
        var label = btn.textContent.trim();
        render(btn.getAttribute('data-group').split(/\s+/), '"' + label + '"', label.toLowerCase());
      }

      function showTag(tag) {
        buttons.forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
        if (select) select.value = tag;
        render([tag], 'topic "' + tag + '"', tag);
      }

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (btn === allBtn) showAll(); else showPillar(btn);
        });
      });
      if (select) {
        select.addEventListener('change', function () {
          if (select.value === '__all__') showAll(); else showTag(select.value);
        });
      }
      if (emptyEl) {
        var resetBtn = emptyEl.querySelector('[data-tag-reset]');
        if (resetBtn) resetBtn.addEventListener('click', showAll);
      }

      // Initial state from ?tag= (homepage topic tiles + shared links): match a
      // pillar label first, then a raw tag option, else show all.
      var initial = new URLSearchParams(window.location.search).get('tag');
      var initialLc = initial ? initial.toLowerCase() : null;
      var matched = false;
      if (initialLc) {
        for (var i = 0; i < buttons.length; i++) {
          if (buttons[i] !== allBtn && buttons[i].textContent.trim().toLowerCase() === initialLc) {
            showPillar(buttons[i]); matched = true; break;
          }
        }
        if (!matched && select) {
          for (var j = 0; j < select.options.length; j++) {
            if (select.options[j].value === initialLc) { showTag(initialLc); matched = true; break; }
          }
        }
      }
      if (!matched) showAll();
    })();
  </script>
</BaseLayout>
