---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Collect unique tags, normalized to lowercase so case-variant duplicates in
// frontmatter (e.g. "HubSpot" vs "hubspot", "Automation" vs "automation")
// collapse into one filter pill. The pills display lowercase anyway (CSS).
const allTags = [...new Set(posts.flatMap((p) => p.data.tags.map((t) => t.toLowerCase())))].sort();
---

<BaseLayout
  title="Blog"
  description="Automation guides, tool reviews, and RevOps workflows from The Automations Guide."
>
  <div class="container--wide">
    <div class="page-header">
      <h1>The Blog</h1>
      <p>Guides, reviews, and playbooks for RevOps and GTM automation.</p>

      <form class="nav-search blog-search" action="/search" method="get" role="search" aria-label="Search posts">
        <span class="nav-search-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input type="search" name="q" placeholder="Search posts..." aria-label="Search posts and tools" autocomplete="off" />
      </form>

      {allTags.length > 0 && (
        <div class="tag-filter" role="group" aria-label="Filter posts by topic">
          <button type="button" class="tag tag--filter" data-tag="__all__" aria-pressed="true">All</button>
          {allTags.map((tag) => (
            <button type="button" class="tag tag--filter" data-tag={tag} aria-pressed="false">{tag}</button>
          ))}
        </div>
      )}

      <p class="tag-filter-count" aria-live="polite" data-total={posts.length}></p>
    </div>

    {posts.length > 0 ? (
      <div class="card-grid" id="post-grid">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="post-card"
            data-tags={post.data.tags.join(' ').toLowerCase()}
          >
            {post.data.tags.length > 0 && (
              <div class="post-card-tags">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <div class="post-card-meta">
              <span>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  month: 'long',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </span>
              <span class="post-meta-sep">·</span>
              <span>{post.data.author}</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div style="text-align:center;padding:5rem 0;color:var(--text-muted);">
        <p style="font-size:1.125rem;">No posts yet, check back soon.</p>
      </div>
    )}

    <p class="tag-filter-empty" hidden>No posts match that topic yet. <button type="button" class="link-button" data-tag-reset>Show all posts</button>.</p>
  </div>

  <script is:inline>
    (function () {
      var pills = Array.prototype.slice.call(document.querySelectorAll('.tag--filter'));
      var cards = Array.prototype.slice.call(document.querySelectorAll('#post-grid .post-card'));
      var countEl = document.querySelector('.tag-filter-count');
      var emptyEl = document.querySelector('.tag-filter-empty');
      if (!pills.length || !cards.length) return;

      var total = cards.length;

      function setCount(n, tag) {
        if (!countEl) return;
        var label = tag && tag !== '__all__'
          ? 'Showing ' + n + ' of ' + total + ' articles tagged "' + tag + '"'
          : 'Showing all ' + total + ' articles';
        countEl.textContent = label;
        if (emptyEl) emptyEl.hidden = n !== 0;
      }

      function apply(rawTag) {
        var tag = rawTag === '__all__' ? '__all__' : String(rawTag).toLowerCase();
        var visible = 0;
        cards.forEach(function (card) {
          var tags = (card.getAttribute('data-tags') || '').split(/\s+/);
          var show = tag === '__all__' || tags.indexOf(tag) !== -1;
          card.hidden = !show;
          if (show) visible++;
        });
        pills.forEach(function (p) {
          p.setAttribute('aria-pressed', p.getAttribute('data-tag') === tag ? 'true' : 'false');
        });
        setCount(visible, tag);
        // Reflect in the URL without reloading (shareable, back-button friendly).
        var url = tag === '__all__'
          ? window.location.pathname
          : window.location.pathname + '?tag=' + encodeURIComponent(tag);
        history.replaceState(null, '', url);
      }

      pills.forEach(function (p) {
        p.addEventListener('click', function () {
          apply(p.getAttribute('data-tag'));
        });
      });

      if (emptyEl) {
        var resetBtn = emptyEl.querySelector('[data-tag-reset]');
        if (resetBtn) resetBtn.addEventListener('click', function () { apply('__all__'); });
      }

      // Initial state from ?tag= (used by homepage topic tiles + shared links).
      var initial = new URLSearchParams(window.location.search).get('tag');
      var initialLc = initial ? initial.toLowerCase() : null;
      var known = initialLc && pills.some(function (p) { return p.getAttribute('data-tag') === initialLc; });
      apply(known ? initialLc : '__all__');
    })();
  </script>
</BaseLayout>
