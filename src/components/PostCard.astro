---
// Shared post card used by the blog index, the audience (Teams) hubs, and the
// Playbooks hub. Keeps `data-tags` so the blog index's client-side topic filter
// keeps working. Author falls back to the human byline (matches BlogPostLayout).
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const author =
  !post.data.author || post.data.author === 'The Automations Guide'
    ? 'Ian Chamberland'
    : post.data.author;
const date = post.data.pubDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<a
  href={`/blog/${post.slug}/`}
  class="post-card"
  data-tags={post.data.tags.map((t) => t.toLowerCase()).join('|')}
>
  {post.data.tags.length > 0 && (
    <div class="post-card-tags">
      {post.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
    </div>
  )}
  <h2>{post.data.title}</h2>
  <p>{post.data.description}</p>
  <div class="post-card-meta">
    <span>{date}</span>
    <span class="post-meta-sep">&middot;</span>
    <span>{author}</span>
  </div>
</a>
