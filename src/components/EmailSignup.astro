---
// Beehiiv newsletter embed.
// Form ID: d41efc59-7041-482b-8178-6d238e6c3cfa
// To swap publications later, replace the data-beehiiv-form ID below + the form ID in this comment.
//
// Beehiiv's loader.js renders the subscribe form inline where the script tag sits. The wrapper
// markup below provides our editorial framing (heading + sub + note); Beehiiv handles the form
// itself + delivery.
const BEEHIIV_FORM_ID = 'd41efc59-7041-482b-8178-6d238e6c3cfa';
---

<section class="email-signup">
  <div class="email-signup-inner">
    <p class="email-signup-eyebrow">Free Newsletter</p>
    <h3 class="email-signup-heading">
      Get weekly automation playbooks for RevOps teams. No fluff.
    </h3>
    <p class="email-signup-sub">
      Join RevOps and GTM operators who get our best automation guides, tool reviews,
      and workflow templates — delivered every week.
    </p>

    <div class="beehiiv-form-wrapper">
      <script async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form={BEEHIIV_FORM_ID}></script>
    </div>

    <p class="email-signup-note">No spam. Unsubscribe anytime.</p>
  </div>
</section>

<style>
  .beehiiv-form-wrapper {
    margin: 1.5rem 0 0.75rem;
    min-height: 80px;
  }
</style>
