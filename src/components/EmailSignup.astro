---
// Beehiiv newsletter embed.
// Form ID: d41efc59-7041-482b-8178-6d238e6c3cfa
// To swap publications later, replace the data-beehiiv-form ID below + the form ID in this comment.
//
// Beehiiv's loader.js renders the subscribe form (a ~290px iframe) inline where the script tag
// sits. We can't restyle inside that cross-origin iframe, so to keep the section compact the copy
// sits BESIDE the form on desktop (two columns) rather than stacked above it.
const BEEHIIV_FORM_ID = 'd41efc59-7041-482b-8178-6d238e6c3cfa';
---

<section class="email-signup">
  <div class="email-signup-grid">
    <div class="email-signup-copy">
      <p class="email-signup-eyebrow">Free Newsletter</p>
      <h3 class="email-signup-heading">
        One automation playbook a week, straight from the field.
      </h3>
      <p class="email-signup-sub">
        Join RevOps and GTM operators who get our best automation guides, tool reviews,
        and workflow templates, delivered every week.
      </p>
      <p class="email-signup-note">No spam. Unsubscribe anytime.</p>
    </div>

    <div class="beehiiv-form-wrapper" data-beehiiv-form={BEEHIIV_FORM_ID}>
      <noscript>
        <a href="/#newsletter" class="btn btn--primary">Subscribe to the newsletter</a>
      </noscript>
    </div>
  </div>
</section>

<script is:inline define:vars={{ BEEHIIV_FORM_ID }}>
  // Lazy-load the beehiiv embed: its loader.js pulls ~25 sub-requests (a Stimulus
  // app, flatpickr, its own webfont + GTM container, a Cloudflare challenge), which
  // tanked mobile LCP/TBT when it ran on initial load. The form is below the fold on
  // every page it appears, so we defer the loader until the wrapper nears the
  // viewport (600px early, so it's ready before the user scrolls to it).
  (function () {
    const script = document.currentScript;
    // The script sits after the <section>, so its previousElementSibling is the
    // section, NOT the wrapper (which is nested inside). Look up the wrapper within
    // that section, falling back to a document-wide lookup.
    const prev = script && script.previousElementSibling;
    const wrap = (prev && prev.querySelector && prev.querySelector('.beehiiv-form-wrapper'))
      || document.querySelector('.beehiiv-form-wrapper');
    if (!wrap) return;
    let loaded = false;
    function load() {
      if (loaded) return;
      loaded = true;
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://subscribe-forms.beehiiv.com/v3/loader.js';
      s.setAttribute('data-beehiiv-form', BEEHIIV_FORM_ID);
      wrap.appendChild(s);
    }
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load(); }
      }, { rootMargin: '600px' });
      io.observe(wrap);
    } else {
      load();
    }
    // Beehiiv injects a cross-origin iframe we can't title at source; set it
    // after injection so screen readers announce the form correctly (L-5).
    if ('MutationObserver' in window) {
      const mo = new MutationObserver(() => {
        const iframe = wrap.querySelector('iframe');
        if (iframe && !iframe.title) {
          iframe.title = 'Newsletter signup form';
          mo.disconnect();
        }
      });
      mo.observe(wrap, { childList: true, subtree: true });
    }
  })();
</script>

<style>
  .beehiiv-form-wrapper {
    margin: 0;
    /* Reserve the ~290px the beehiiv iframe occupies so the lazy injection
       doesn't shift layout (keeps CLS at 0). */
    min-height: 290px;
  }

  /* Beehiiv's iframe is a fixed cross-origin widget we can't restyle inside
     (see the loader comment above) — below ~301px wide, its own responsive
     layout clips the "Subscribe" label to "Subscri". Below the 768px
     breakpoint where the card is single-column, bleed the wrapper past the
     card's own horizontal padding so the iframe gets that width back; the
     copy column keeps its inset via .email-signup-copy. */
  @media (max-width: 767px) {
    .beehiiv-form-wrapper {
      margin-left: -2rem;
      margin-right: -2rem;
    }
  }
</style>
