---
// Clean, data-driven decision tree for "which tool should you pick" sections.
// Replaces hand-drawn inline SVG trees (fragile sizing + amateur look) with a
// consistent, on-brand, responsive HTML/CSS flow. Supports nested decisions.
//
// USAGE in MDX posts:
//   import DecisionTree from '@/components/post/DecisionTree.astro';
//
//   <DecisionTree
//     caption="Clay vs Zapier for lead enrichment"
//     footer="Best together: Clay enriches, Zapier pushes to CRM."
//     tree={{
//       question: "Multi-provider or bulk enrichment (500+ rows)?",
//       branches: [
//         { label: "Yes", result: { title: "Use Clay", note: "Waterfall enrichment", tone: "primary" } },
//         { label: "No",  result: { title: "Use Zapier", note: "Trigger-based enrichment", tone: "alt" } },
//       ],
//     }}
//   />
//
// Nested: a branch can carry `next` (another question) instead of `result`.

export interface Leaf {
  title: string;
  note?: string;
  /** primary = teal (recommended), alt = amber (alternative), neutral = muted. */
  tone?: 'primary' | 'alt' | 'neutral';
}
export interface Branch {
  label: string;
  result?: Leaf;
  next?: TreeNode;
}
export interface TreeNode {
  question: string;
  branches: Branch[];
}

interface Props {
  tree: TreeNode;
  caption?: string;
  footer?: string;
  /** Internal: set when this component renders a nested sub-decision. */
  nested?: boolean;
}

const { tree, caption, footer, nested = false } = Astro.props;
const Self = (await import('./DecisionTree.astro')).default;
---

{nested ? (
  <div class="dtree-node">
    <div class="dtree-q">{tree.question}</div>
    <div class="dtree-branches">
      {tree.branches.map((b) => (
        <div class="dtree-branch">
          <span class="dtree-label">{b.label}</span>
          {b.next ? (
            <Self tree={b.next} nested={true} />
          ) : (
            <div class={`dtree-leaf dtree-leaf--${b.result?.tone ?? 'neutral'}`}>
              <span class="dtree-leaf-title">{b.result?.title}</span>
              {b.result?.note && <span class="dtree-leaf-note">{b.result.note}</span>}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
) : (
  <figure class="dtree">
    <div class="dtree-flow">
      <div class="dtree-node">
        <div class="dtree-q dtree-q--root">{tree.question}</div>
        <div class="dtree-branches">
          {tree.branches.map((b) => (
            <div class="dtree-branch">
              <span class="dtree-label">{b.label}</span>
              {b.next ? (
                <Self tree={b.next} nested={true} />
              ) : (
                <div class={`dtree-leaf dtree-leaf--${b.result?.tone ?? 'neutral'}`}>
                  <span class="dtree-leaf-title">{b.result?.title}</span>
                  {b.result?.note && <span class="dtree-leaf-note">{b.result.note}</span>}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
    {footer && <p class="dtree-footer">{footer}</p>}
    {caption && <figcaption class="dtree-caption">{caption}</figcaption>}
  </figure>
)}

<style>
  .dtree {
    margin: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    padding: 1.5rem 1.25rem 1.25rem;
  }
  .dtree-flow { display: flex; justify-content: center; }
  .dtree-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  /* Question pill */
  .dtree-q {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--accent-dim);
    color: var(--text);
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.3;
    text-align: center;
    padding: 0.6rem 0.9rem;
    border-radius: 0.6rem;
    max-width: 22rem;
  }
  .dtree-q--root {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast, #fff);
  }
  /* Branch row: connector drops down then fans out */
  .dtree-branches {
    display: flex;
    gap: 1rem;
    margin-top: 1.4rem;
    position: relative;
    flex-wrap: wrap;
    justify-content: center;
  }
  /* vertical connector from question into the branch row */
  .dtree-branches::before {
    content: "";
    position: absolute;
    top: -1.4rem;
    left: 50%;
    width: 1px;
    height: 1.4rem;
    background: var(--border);
  }
  .dtree-branch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    position: relative;
    flex: 1 1 9rem;
    min-width: 8.5rem;
    max-width: 14rem;
  }
  /* short connector above each branch */
  .dtree-branch::before {
    content: "";
    width: 1px;
    height: 0.55rem;
    background: var(--border);
  }
  .dtree-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.12rem 0.6rem;
  }
  .dtree-leaf {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: center;
    width: 100%;
    padding: 0.7rem 0.75rem;
    border-radius: 0.6rem;
    border: 1px solid var(--border);
    background: var(--bg-card);
  }
  .dtree-leaf-title { font-weight: 700; font-size: 0.9rem; color: var(--text); }
  .dtree-leaf-note { font-size: 0.76rem; color: var(--text-muted); line-height: 1.3; }
  .dtree-leaf--primary {
    background: var(--accent-glow);
    border-color: var(--accent);
  }
  .dtree-leaf--primary .dtree-leaf-title { color: var(--accent-dim); }
  .dtree-leaf--alt {
    background: color-mix(in srgb, var(--accent-amber, #f59e0b) 12%, transparent);
    border-color: var(--accent-amber, #f59e0b);
  }
  .dtree-footer {
    margin: 1.1rem auto 0;
    max-width: 26rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px dashed var(--border);
    border-radius: 0.5rem;
    padding: 0.55rem 0.75rem;
  }
  .dtree-caption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  /* Nested decisions: tighter, no card chrome (the outer card frames it). */
  .dtree-node .dtree-node { margin-top: 0; }

  @media (max-width: 560px) {
    .dtree-branches { flex-direction: column; align-items: stretch; gap: 0.85rem; }
    .dtree-branches::before { display: none; }
    .dtree-branch { max-width: none; }
    .dtree-branch::before { display: none; }
  }
</style>
