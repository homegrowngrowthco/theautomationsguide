---
// On-page table of contents: the sticky left rail of the post shell on wide
// screens, a collapsed disclosure above the article below 1100px (BlogPostLayout,
// design program 2026-10). hasToc()/tocHeadings()
// live in src/lib/post-toc.ts so the layout can know ahead of render whether this
// will show at all. Renders nothing for short posts (< 3 H2s).
import { tocHeadings, hasToc, type TocHeading } from '../../lib/post-toc';

interface Props {
  headings?: TocHeading[];
}

const { headings = [] } = Astro.props;
const h2s = tocHeadings(headings);
const show = hasToc(headings);
---

{show && (
  <details class="post-toc" open>
    <summary class="post-toc-summary">On this page</summary>
    <nav aria-label="Table of contents">
      <ol class="post-toc-list">
        {h2s.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </nav>
  </details>
)}

<script is:inline>
  // Design program 2026-10: the ToC is a sticky rail on wide screens and a
  // collapsed disclosure below 1100px (it sits above the article there, so an
  // open list would push the content down). Runs as the element is parsed, before
  // first paint, so it causes no layout shift. Then highlights the section in view.
  (function () {
    var toc = document.currentScript && document.currentScript.previousElementSibling;
    if (!toc || !toc.classList.contains('post-toc')) return;
    if (window.matchMedia('(max-width: 1100px)').matches) toc.removeAttribute('open');
    if (!('IntersectionObserver' in window)) return;
    var links = toc.querySelectorAll('a[href^="#"]');
    var byId = {};
    links.forEach(function (a) { byId[decodeURIComponent(a.getAttribute('href').slice(1))] = a; });
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        links.forEach(function (a) { a.removeAttribute('aria-current'); });
        var a = byId[e.target.id];
        if (a) a.setAttribute('aria-current', 'true');
      });
    }, { rootMargin: '-15% 0px -70% 0px' });
    Object.keys(byId).forEach(function (id) { var h = document.getElementById(id); if (h) io.observe(h); });
  })();
</script>

<style>
  .post-toc { margin: 0; }
  .post-toc-summary {
    list-style: none; cursor: pointer;
    font: 600 0.75rem/1 var(--font-sans); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted);
    padding: 0.25rem 0 0.75rem;
  }
  .post-toc-summary::-webkit-details-marker { display: none; }
  .post-toc-list { margin: 0; padding: 0; list-style: none; border-left: 1px solid var(--border); }
  .post-toc-list li { margin: 0; }
  .post-toc-list a {
    display: block; margin-left: -1px; padding: 0.4rem 0 0.4rem 0.85rem;
    border-left: 2px solid transparent;
    font: 400 0.88rem/1.4 var(--font-sans); color: var(--ink-600); text-decoration: none;
  }
  .post-toc-list a:hover { color: var(--ink-900); }
  .post-toc-list a[aria-current] { border-left-color: var(--tag-teal-600); color: var(--ink-900); font-weight: 600; }
  @media (min-width: 1101px) {
    .post-toc-summary { pointer-events: none; }
  }
  @media (max-width: 1100px) {
    .post-toc { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 0.85rem 1.1rem; margin: 0 0 1.5rem; }
    .post-toc-summary { padding: 0.15rem 0; display: flex; justify-content: space-between; }
    .post-toc-summary::after { content: '+'; color: var(--accent-text); font-size: 1rem; }
    .post-toc[open] .post-toc-summary::after { content: '\2212'; }
    .post-toc[open] .post-toc-summary { padding-bottom: 0.6rem; }
  }
</style>
