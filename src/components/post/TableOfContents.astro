---
// On-page table of contents. Paired with the TL;DR box (see BlogPostLayout.astro's
// .post-intro/.post-intro--paired) when both exist, so it reads as a compact
// sidebar-style card rather than a lone full-width strip. hasToc()/tocHeadings()
// live in src/lib/post-toc.ts so the layout can know ahead of render whether this
// will show at all. Renders nothing for short posts (< 3 H2s).
import { tocHeadings, hasToc, type TocHeading } from '../../lib/post-toc';

interface Props {
  headings?: TocHeading[];
}

const { headings = [] } = Astro.props;
const h2s = tocHeadings(headings);
const show = hasToc(headings);
---

{show && (
  <details class="post-toc" open>
    <summary class="post-toc-summary">On this page</summary>
    <nav aria-label="Table of contents">
      <ol class="post-toc-list">
        {h2s.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </nav>
  </details>
)}

<style>
  .post-toc {
    /* Standalone width cap (no TL;DR to pair with) — matches the grid column
       width .post-intro--paired gives it when both are present, so the card
       reads the same size either way instead of stretching full-width. */
    max-width: 420px;
    margin: 1.5rem 0 2rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    padding: 0.85rem 1.25rem;
  }
  .post-intro--paired .post-toc {
    max-width: none;
    /* Mobile-stacked (below the grid breakpoint in global.css): top gap from
       the TL;DR box above it; .post-intro's own bottom margin handles the
       space before the article body. At the grid breakpoint this collapses
       to 0 since the grid's gap takes over. */
    margin: 1rem 0 0;
  }
  .post-toc-summary {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    cursor: pointer;
    list-style: none;
  }
  .post-toc-summary::-webkit-details-marker { display: none; }
  .post-toc-summary::after {
    content: "+";
    float: right;
    color: var(--accent);
    font-weight: 700;
  }
  .post-toc[open] .post-toc-summary::after { content: "\2212"; }
  /* Vertical list — one link per line. A narrow sidebar-style card reads better
     as a stacked list than a wrapped horizontal strip. */
  .post-toc-list {
    margin: 0.6rem 0 0;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .post-toc-list li { margin: 0; }
  .post-toc-list a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .post-toc-list a:hover { color: var(--accent); text-decoration: underline; }
</style>
