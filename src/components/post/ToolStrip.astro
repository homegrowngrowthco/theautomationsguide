---
// The tools panel: lifts out of the post's ink title band on comparison posts
// (design program 2026-10, direction "Ink spec"; was the one-line "Tools
// compared:" strip, conversion audit F3/R7). Puts every compared tool, its entry
// price from the pricing index (dated) and its /go/ link above the fold.
//
// Honesty rules: tools come only from the post (src/lib/tools-compared.ts); a
// "best for" line and the pick badge appear only when the post's own
// ComparisonTable states them; a tool without a live program gets "Visit", not
// "Try"; a price shows only when the index has one, with the index's read date.
//
// The root class MUST stay `tool-strip`: ClickSource.astro reports clicks here as
// source_component=tool-strip, and the pre-registered 10/15 and 11/26 reads
// compare that value before and after the redesign.
import { toolsCompared } from '../../lib/tools-compared';
import { pricingReadDate } from '../../lib/pricing-index';

interface Props {
  body: string;
  title: string;
}
const { body, title } = Astro.props;
const items = toolsCompared(body, title);
const hasPick = items.some((t) => t.pick);
const anyPrice = items.some((t) => t.price);
const readDate = new Date(`${pricingReadDate}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

{items.length > 0 && (
  <section class="tool-strip" aria-labelledby="tool-strip-title" style={`--cols:${items.length}`}>
    <header class="tool-strip-head">
      <h2 id="tool-strip-title">{hasPick ? 'The verdict' : 'The tools compared'}</h2>
      {anyPrice && <p>Entry prices from the <a href="/revops-automation-pricing/">pricing index</a>, read {readDate}</p>}
    </header>
    <div class="tool-strip-grid">
      {items.map((t) => (
        <div class={`tool-strip-col${t.pick ? ' tool-strip-col--pick' : ''}`}>
          <div class="tool-strip-name">
            <span class="tool-strip-logo">
              {t.logo ? <img src={t.logo} alt="" width="28" height="28" loading="eager" decoding="async" /> : <span aria-hidden="true">{t.name.charAt(0)}</span>}
            </span>
            <span>{t.name}</span>
          </div>
          {t.pick && <span class="tool-strip-badge">Our pick</span>}
          {t.tagline && <p class="tool-strip-tag">{t.tagline}</p>}
          {t.price ? (
            <p class="tool-strip-price">
              <span class="tool-strip-amt">{t.price.amount}</span><span class="tool-strip-per">/mo{t.price.plan ? ` ${t.price.plan}` : ''}</span>
              <span class="tool-strip-note">{t.price.note}</span>
            </p>
          ) : (
            <p class="tool-strip-note tool-strip-note--none">Not in the pricing index yet</p>
          )}
          <a
            href={`/go/${t.slug}/`}
            class={`tool-strip-cta${t.pick ? ' tool-strip-cta--pick' : ''}`}
            target="_blank"
            rel="noopener noreferrer sponsored"
          >
            {t.status === 'live' ? `Try ${t.name}` : `Visit ${t.name}`}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .tool-strip {
    background: var(--bg-card);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
    color: var(--text);
  }
  .tool-strip-head {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.25rem 1rem;
    padding: 0.9rem 1.15rem; border-bottom: 1px solid var(--border);
  }
  .tool-strip-head h2 { margin: 0; font: 600 0.95rem/1.2 var(--font-sans); color: var(--ink-900); letter-spacing: 0; }
  .tool-strip-head p { margin: 0; font: 400 0.8rem/1.4 var(--font-sans); color: var(--text-muted); }
  .tool-strip-head a { color: var(--accent-text); text-decoration: underline; text-underline-offset: 2px; }
  .tool-strip-grid { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
  .tool-strip-col {
    display: flex; flex-direction: column; gap: 0.55rem; min-width: 0;
    padding: 1.15rem; border-right: 1px solid var(--border);
  }
  .tool-strip-col:last-child { border-right: 0; }
  .tool-strip-col--pick { background: var(--tag-teal-50); }
  .tool-strip-name { display: flex; align-items: center; gap: 0.6rem; font: 600 1rem/1.25 var(--font-sans); color: var(--ink-900); }
  .tool-strip-logo {
    width: 40px; height: 40px; flex: none; border-radius: 8px; background: #fff; border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center; font: 700 1rem var(--font-sans); color: var(--ink-600);
  }
  .tool-strip-logo img { width: 26px; height: 26px; object-fit: contain; }
  .tool-strip-badge {
    align-self: flex-start; padding: 0.3rem 0.5rem; border-radius: 4px;
    background: var(--tag-teal-700); color: #fff; font: 600 0.72rem/1 var(--font-sans);
  }
  .tool-strip-tag { margin: 0; font: 400 0.88rem/1.45 var(--font-sans); color: var(--ink-600); }
  .tool-strip-price { margin: 0.15rem 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.3rem; }
  .tool-strip-amt { font: 700 1.75rem/1.1 var(--font-sans); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; color: var(--ink-900); }
  .tool-strip-per { font: 400 0.82rem var(--font-sans); color: var(--text-muted); }
  .tool-strip-note { flex-basis: 100%; margin: 0.15rem 0 0; font: 400 0.78rem/1.4 var(--font-sans); color: var(--text-muted); }
  .tool-strip-note--none { margin-top: auto; }
  .tool-strip-cta {
    margin-top: auto; display: flex; align-items: center; justify-content: center; gap: 0.45rem;
    min-height: 44px; padding: 0.55rem 1rem; border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong); background: #fff; color: var(--ink-800);
    font: 600 0.92rem/1.25 var(--font-sans); text-align: center; text-decoration: none;
    transition: border-color 150ms, background-color 150ms;
  }
  .tool-strip-cta:hover { border-color: var(--ink-500); color: var(--ink-900); text-decoration: none; }
  .tool-strip-cta--pick { background: var(--tag-teal-700); border-color: var(--tag-teal-700); color: #fff; }
  .tool-strip-cta--pick:hover { background: var(--tag-teal-800); border-color: var(--tag-teal-800); color: #fff; }
  .tool-strip-cta:focus-visible { outline: 2px solid var(--tag-teal-500); outline-offset: 2px; }
  .tool-strip-price + .tool-strip-cta, .tool-strip-tag + .tool-strip-cta { margin-top: auto; }
  @media (max-width: 820px) {
    .tool-strip-grid { grid-template-columns: minmax(0, 1fr); }
    .tool-strip-col { border-right: 0; border-bottom: 1px solid var(--border); }
    .tool-strip-col:last-child { border-bottom: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .tool-strip-cta { transition: none; } }
</style>
