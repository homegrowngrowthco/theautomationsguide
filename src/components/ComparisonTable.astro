---
// Reusable comparison table for tool / product / option comparisons in posts.
//
// USAGE in markdown posts:
//   import ComparisonTable from '../../components/ComparisonTable.astro';
//
//   <ComparisonTable
//     title="Make vs Zapier vs n8n"
//     tools={[
//       {
//         name: 'Make',
//         tagline: 'Best for visual multi-step workflows',
//         pros: ['Visual builder', 'Generous free tier', 'Powerful iterators'],
//         cons: ['Steeper learning curve', 'Pricing scales fast at high ops'],
//         pricing: 'Free → $9/mo',
//         affiliateSlug: 'make',
//         ctaLabel: 'Try Make Free',
//         highlight: true,
//       },
//       { name: 'Zapier', ... },
//     ]}
//   />

import { indexPriceFor } from '../lib/tools-compared';
import { pricingReadDate } from '../lib/pricing-index';

interface Tool {
  name: string;
  tagline: string;
  pros: string[];
  cons: string[];
  pricing?: string;
  affiliateSlug?: string;
  ctaLabel?: string;
  highlight?: boolean;
}

interface Props {
  title?: string;
  tools?: Tool[];
  /** `items` is accepted as an alias for `tools` (the sibling KeyTakeaways takes
      `items=`, so a generated post occasionally passes it here). `tools` wins
      when both are set. */
  items?: Tool[];
  /** Slim at-a-glance variant: name + tagline + pricing + CTA per row, no pros/cons.
      Pairs well with prose paragraphs below it. */
  compact?: boolean;
}

const { title, tools, items, compact = false } = Astro.props;
const toolList = (tools && tools.length ? tools : items) ?? [];

// The dated pricing-index price replaces the post's prose price when the index has
// one (Ian, 2026-10-02), so the tools panel and this table never disagree.
const readDate = new Date(`${pricingReadDate}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const priceText = (tool: Tool): { text?: string; read?: string } => {
  const p = indexPriceFor(tool.name, tool.affiliateSlug);
  if (!p) return { text: tool.pricing };
  return { text: `${p.plan ? `${p.plan}: ` : ''}${p.amount}/mo, ${p.note}`, read: `Pricing index, read ${readDate}` };
};
---

<section class:list={['comparison-table', compact && 'comparison-table--compact']}>
  {title && <h3 class="comparison-title">{title}</h3>}
  {compact ? (
    <div class="comparison-compact">
      {toolList.map((tool) => (
        <div class={`ccompact-row ${tool.highlight ? 'ccompact-row--highlight' : ''}`}>
          <div class="ccompact-main">
            <span class="ccompact-name">
              {tool.name}
              {tool.highlight && <span class="ccompact-pick">Top pick</span>}
            </span>
            <span class="ccompact-tagline">{tool.tagline}</span>
          </div>
          {priceText(tool).text && (
            <span class="ccompact-price">
              {priceText(tool).text}
              {priceText(tool).read && <span class="cprice-read">{priceText(tool).read}</span>}
            </span>
          )}
          {tool.affiliateSlug && (
            <a
              href={`/go/${tool.affiliateSlug}/`}
              class="ccompact-cta"
              target="_blank"
              rel="noopener noreferrer sponsored"
            >
              {tool.ctaLabel || `Try ${tool.name}`} &rarr;
            </a>
          )}
        </div>
      ))}
    </div>
  ) : (
  <div class="comparison-grid" style={`--cols: ${toolList.length}`}>
    {toolList.map((tool) => (
      <div class={`comparison-card ${tool.highlight ? 'comparison-card--highlight' : ''}`}>
        {tool.highlight && <div class="comparison-badge">Top pick</div>}
        <h4 class="comparison-name">{tool.name}</h4>
        <p class="comparison-tagline">{tool.tagline}</p>

        {priceText(tool).text && (
          <p class="comparison-pricing">
            <strong>Pricing:</strong> {priceText(tool).text}
            {priceText(tool).read && <span class="cprice-read">{priceText(tool).read}</span>}
          </p>
        )}

        <div class="comparison-section">
          <strong class="comparison-section-label">What it's good at</strong>
          <ul class="comparison-list comparison-list--pros">
            {(tool.pros ?? []).map((p) => <li>{p}</li>)}
          </ul>
        </div>

        <div class="comparison-section">
          <strong class="comparison-section-label">Where it falls short</strong>
          <ul class="comparison-list comparison-list--cons">
            {(tool.cons ?? []).map((c) => <li>{c}</li>)}
          </ul>
        </div>

        {/* Every column should link to /go/<slug> — even tools without an
            affiliate program (they fall back to homepage + UTM in
            affiliate-links.ts). Always set affiliateSlug so all columns render
            an identical CTA. If a slug is genuinely omitted, the whole actions
            row (divider + button) is skipped so the card degrades cleanly
            rather than showing an empty bordered gap. */}
        {tool.affiliateSlug && (
          <div class="comparison-actions">
            <a
              href={`/go/${tool.affiliateSlug}/`}
              class={`comparison-cta ${tool.highlight ? 'comparison-cta--primary' : 'comparison-cta--ghost'}`}
              target="_blank"
              rel="noopener noreferrer sponsored"
            >
              {tool.ctaLabel || `Try ${tool.name}`} &rarr;
            </a>
          </div>
        )}
      </div>
    ))}
  </div>
  )}
</section>

<style>
  /* 2026-10 ("Ink spec"): white cards with hairlines, AA text colors, no nowrap
     (a nowrap price line was clipped inside the row at 390, teardown 10/02).
     Root class stays `comparison...`: ClickSource reports comparison-table. */
  .comparison-table { margin: 2.5rem 0; }
  .comparison-title {
    font: 600 var(--step-2)/1.3 var(--font-sans);
    margin: 0 0 1rem;
    color: var(--ink-900);
  }
  .comparison-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  @media (min-width: 640px) {
    .comparison-grid { grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); }
  }
  .comparison-card {
    position: relative; min-width: 0;
    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md);
    padding: 1.4rem 1.25rem 1.25rem; display: flex; flex-direction: column;
  }
  .comparison-card--highlight { border: 2px solid var(--tag-teal-600); padding: calc(1.4rem - 1px) calc(1.25rem - 1px) calc(1.25rem - 1px); }
  .comparison-badge {
    position: absolute; top: -0.7rem; left: 1rem;
    background: var(--tag-teal-700); color: #fff;
    font: 600 0.72rem/1 var(--font-sans); padding: 0.35rem 0.55rem; border-radius: 4px;
  }
  .comparison-name { font: 600 var(--step-2)/1.25 var(--font-sans); margin: 0 0 0.35rem; color: var(--ink-900); }
  .comparison-tagline { color: var(--ink-600); font-size: 0.92rem; line-height: 1.45; margin: 0 0 0.9rem; }
  .comparison-pricing {
    font-size: 0.88rem; color: var(--ink-700); font-variant-numeric: tabular-nums;
    margin: 0 0 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border);
  }
  .comparison-section { margin-bottom: 1rem; }
  .comparison-section-label {
    display: block; font: 600 0.72rem/1 var(--font-sans); text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--text-muted); margin-bottom: 0.45rem;
  }
  .comparison-list { margin: 0; padding-left: 1.125rem; font-size: 0.92rem; line-height: 1.5; color: var(--ink-700); }
  .comparison-list li { margin-bottom: 0.3rem; }
  .comparison-list--pros li::marker { color: var(--tag-teal-600); }
  .comparison-list--cons li::marker { color: #c2410c; }
  /* Actions pinned to the bottom of every card so the buttons line up. */
  .comparison-actions { margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border); }
  .comparison-cta {
    display: flex; align-items: center; justify-content: center; min-height: 44px;
    text-align: center; text-decoration: none; font: 600 0.92rem/1.25 var(--font-sans);
    padding: 0.6rem 1rem; border-radius: var(--radius-sm);
    transition: background-color 150ms, border-color 150ms;
  }
  .comparison-cta--ghost { color: var(--ink-800); background: #fff; border: 1px solid var(--border-strong); }
  .comparison-cta--ghost:hover { border-color: var(--ink-500); color: var(--ink-900); text-decoration: none; }
  .comparison-cta--primary { background: var(--tag-teal-700); color: #fff; border: 1px solid var(--tag-teal-700); }
  .comparison-cta--primary:hover { background: var(--tag-teal-800); border-color: var(--tag-teal-800); color: #fff; text-decoration: none; }

  /* ── Compact variant: slim at-a-glance rows (no pros/cons) ── */
  .comparison-compact {
    display: flex; flex-direction: column;
    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden;
  }
  .ccompact-row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem;
    padding: 1rem 1.15rem; border-top: 1px solid var(--border);
  }
  .ccompact-row:first-child { border-top: none; }
  .ccompact-row--highlight { background: var(--tag-teal-50); }
  .ccompact-main { display: flex; flex-direction: column; gap: 0.2rem; flex: 1 1 260px; min-width: 0; }
  .ccompact-name { font: 600 1rem/1.3 var(--font-sans); color: var(--ink-900); display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .ccompact-pick {
    font: 600 0.68rem/1 var(--font-sans); letter-spacing: 0.02em;
    color: #fff; background: var(--tag-teal-700); padding: 0.3rem 0.45rem; border-radius: 4px;
  }
  .ccompact-tagline { color: var(--ink-600); font-size: 0.88rem; line-height: 1.4; }
  .ccompact-price { flex: 1 1 200px; min-width: 0; font-size: 0.86rem; line-height: 1.45; color: var(--ink-700); font-variant-numeric: tabular-nums; }
  .ccompact-cta {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
    text-decoration: none; font: 600 0.88rem/1.2 var(--font-sans); text-align: center;
    color: var(--ink-800); background: #fff; border: 1px solid var(--border-strong); border-radius: var(--radius-sm);
    padding: 0.5rem 0.9rem; transition: border-color 150ms;
  }
  .ccompact-cta:hover { border-color: var(--ink-500); color: var(--ink-900); text-decoration: none; }
  .ccompact-row--highlight .ccompact-cta { background: var(--tag-teal-700); border-color: var(--tag-teal-700); color: #fff; }
  .ccompact-row--highlight .ccompact-cta:hover { background: var(--tag-teal-800); border-color: var(--tag-teal-800); }
  @media (max-width: 600px) {
    .ccompact-cta { flex: 1 1 100%; }
  }
  .cprice-read { display: block; margin-top: 0.15rem; font-size: 0.75rem; color: var(--text-muted); }
  @media (prefers-reduced-motion: reduce) { .comparison-cta, .ccompact-cta { transition: none; } }
</style>
