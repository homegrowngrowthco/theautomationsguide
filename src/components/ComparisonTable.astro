---
// Reusable comparison table for tool / product / option comparisons in posts.
//
// USAGE in markdown posts:
//   import ComparisonTable from '../../components/ComparisonTable.astro';
//
//   <ComparisonTable
//     title="Make vs Zapier vs n8n"
//     tools={[
//       {
//         name: 'Make',
//         tagline: 'Best for visual multi-step workflows',
//         pros: ['Visual builder', 'Generous free tier', 'Powerful iterators'],
//         cons: ['Steeper learning curve', 'Pricing scales fast at high ops'],
//         pricing: 'Free → $9/mo',
//         affiliateSlug: 'make',
//         ctaLabel: 'Try Make Free',
//         highlight: true,
//       },
//       { name: 'Zapier', ... },
//     ]}
//   />

interface Tool {
  name: string;
  tagline: string;
  pros: string[];
  cons: string[];
  pricing?: string;
  affiliateSlug?: string;
  ctaLabel?: string;
  highlight?: boolean;
}

interface Props {
  title?: string;
  tools?: Tool[];
  /** `items` is accepted as an alias for `tools` (the sibling KeyTakeaways takes
      `items=`, so a generated post occasionally passes it here). `tools` wins
      when both are set. */
  items?: Tool[];
  /** Slim at-a-glance variant: name + tagline + pricing + CTA per row, no pros/cons.
      Pairs well with prose paragraphs below it. */
  compact?: boolean;
}

const { title, tools, items, compact = false } = Astro.props;
const toolList = (tools && tools.length ? tools : items) ?? [];
---

<section class:list={['comparison-table', compact && 'comparison-table--compact']}>
  {title && <h3 class="comparison-title">{title}</h3>}
  {compact ? (
    <div class="comparison-compact">
      {toolList.map((tool) => (
        <div class={`ccompact-row ${tool.highlight ? 'ccompact-row--highlight' : ''}`}>
          <div class="ccompact-main">
            <span class="ccompact-name">
              {tool.name}
              {tool.highlight && <span class="ccompact-pick">Top pick</span>}
            </span>
            <span class="ccompact-tagline">{tool.tagline}</span>
          </div>
          {tool.pricing && <span class="ccompact-price">{tool.pricing}</span>}
          {tool.affiliateSlug && (
            <a
              href={`/go/${tool.affiliateSlug}/`}
              class="ccompact-cta"
              target="_blank"
              rel="noopener noreferrer sponsored"
            >
              {tool.ctaLabel || `Try ${tool.name}`} &rarr;
            </a>
          )}
        </div>
      ))}
    </div>
  ) : (
  <div class="comparison-grid" style={`--cols: ${toolList.length}`}>
    {toolList.map((tool) => (
      <div class={`comparison-card ${tool.highlight ? 'comparison-card--highlight' : ''}`}>
        {tool.highlight && <div class="comparison-badge">Top pick</div>}
        <h4 class="comparison-name">{tool.name}</h4>
        <p class="comparison-tagline">{tool.tagline}</p>

        {tool.pricing && (
          <p class="comparison-pricing"><strong>Pricing:</strong> {tool.pricing}</p>
        )}

        <div class="comparison-section">
          <strong class="comparison-section-label">What it's good at</strong>
          <ul class="comparison-list comparison-list--pros">
            {(tool.pros ?? []).map((p) => <li>{p}</li>)}
          </ul>
        </div>

        <div class="comparison-section">
          <strong class="comparison-section-label">Where it falls short</strong>
          <ul class="comparison-list comparison-list--cons">
            {(tool.cons ?? []).map((c) => <li>{c}</li>)}
          </ul>
        </div>

        {/* Every column should link to /go/<slug> — even tools without an
            affiliate program (they fall back to homepage + UTM in
            affiliate-links.ts). Always set affiliateSlug so all columns render
            an identical CTA. If a slug is genuinely omitted, the whole actions
            row (divider + button) is skipped so the card degrades cleanly
            rather than showing an empty bordered gap. */}
        {tool.affiliateSlug && (
          <div class="comparison-actions">
            <a
              href={`/go/${tool.affiliateSlug}/`}
              class={`comparison-cta ${tool.highlight ? 'comparison-cta--primary' : 'comparison-cta--ghost'}`}
              target="_blank"
              rel="noopener noreferrer sponsored"
            >
              {tool.ctaLabel || `Try ${tool.name}`} &rarr;
            </a>
          </div>
        )}
      </div>
    ))}
  </div>
  )}
</section>

<style>
  .comparison-table {
    margin: 2.5rem 0;
  }
  .comparison-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: var(--text);
  }
  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  /* On wider screens, force one row at the actual tool count
     (set via --cols inline style on .comparison-grid). */
  @media (min-width: 640px) {
    .comparison-grid { grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); }
  }
  .comparison-card {
    position: relative;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .comparison-card--highlight {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .comparison-badge {
    position: absolute;
    top: -0.625rem;
    right: 1rem;
    background: var(--accent);
    color: var(--bg);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .comparison-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.375rem 0;
    color: var(--text);
  }
  .comparison-tagline {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: 0 0 1rem 0;
  }
  .comparison-pricing {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0 0 1rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .comparison-section {
    margin-bottom: 1rem;
  }
  .comparison-section-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.375rem;
  }
  .comparison-list {
    margin: 0;
    padding-left: 1.125rem;
    font-size: 0.9375rem;
    color: var(--text);
  }
  .comparison-list li {
    margin-bottom: 0.25rem;
  }
  .comparison-list--pros li::marker { color: var(--accent); }
  .comparison-list--cons li::marker { color: #f87171; }
  /* Actions row: pinned to the bottom of every card with an identical top
     divider, so all columns line up and read the same regardless of how many
     pros/cons each lists or whether it's the highlighted "Top pick". */
  .comparison-actions {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .comparison-cta {
    display: block;
    text-align: center;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.7rem 1rem;
    border-radius: 0.5rem;
    transition: opacity 0.15s, background 0.15s;
  }
  /* Non-highlighted columns: outlined ghost button (uniform with each other). */
  .comparison-cta--ghost {
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent-dim);
  }
  .comparison-cta--ghost:hover { background: var(--accent-glow); }
  /* The "Top pick" keeps a filled teal button so it still stands out. */
  .comparison-cta--primary {
    background: var(--accent);
    color: var(--accent-contrast, var(--bg));
    border: 1px solid var(--accent);
  }
  .comparison-cta--primary:hover { opacity: 0.9; }

  /* ── Compact variant: slim at-a-glance rows (no pros/cons) ── */
  .comparison-compact {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .ccompact-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
  }
  .ccompact-row:first-child { border-top: none; }
  .ccompact-row--highlight {
    background: var(--accent-glow);
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .ccompact-main {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1 1 auto;
    min-width: 0;
  }
  .ccompact-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ccompact-pick {
    font-family: var(--font-mono, monospace);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-contrast, #fff);
    background: var(--accent);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
  }
  .ccompact-tagline {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .ccompact-price {
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .ccompact-cta {
    flex: 0 0 auto;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    border-radius: 0.5rem;
    padding: 0.45rem 0.85rem;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .ccompact-cta:hover { background: var(--accent-glow); }
  @media (max-width: 600px) {
    .ccompact-row { flex-wrap: wrap; gap: 0.5rem 1rem; }
    .ccompact-main { flex: 1 1 100%; }
    .ccompact-cta { margin-left: auto; }
  }
</style>
