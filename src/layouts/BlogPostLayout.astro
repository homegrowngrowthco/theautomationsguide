---
import BaseLayout from './BaseLayout.astro';
import EmailSignup from '../components/EmailSignup.astro';
import AuthorNote from '../components/AuthorNote.astro';
import PostFaqs from '../components/post/PostFaqs.astro';
import TableOfContents from '../components/post/TableOfContents.astro';
import RelatedPosts from '../components/post/RelatedPosts.astro';
import { tools, postMentionsTool } from '../data/tools';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: MarkdownHeading[];
  related?: { slug: string; title: string; description: string }[];
}

const { post, headings = [], related = [] } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags, faqs } = post.data;

// Byline person. Posts without an explicit author fall back to the org name
// ("The Automations Guide"); show the human (Ian) there instead, since the brand
// is already appended after the name and in the publisher schema.
const displayAuthor = !author || author === 'The Automations Guide' ? 'Ian' : author;

// Per-post OG image (build-time PNG at /og/<slug>.png). Used for og:image,
// twitter:image, and the BlogPosting `image`.
const ogImage = new URL(`/og/${post.slug}.png`, Astro.site).toString();

// Tools this post compares, for JSON-LD about/mentions (entity-graph signal).
const mentionedTools = tools
  .filter((t) => postMentionsTool(t, post))
  .map((t) => ({
    '@type': 'SoftwareApplication',
    name: t.name,
    applicationCategory: 'BusinessApplication',
    url: new URL(`/tools/${t.slug}/`, Astro.site).toString(),
  }));

const wordCount = post.body.split(/\s+/).filter(Boolean).length;
const readTime = Math.max(1, Math.round(wordCount / 200));

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const postUrl = new URL(`/blog/${post.slug}/`, Astro.site).toString();

const isNamedAuthor = displayAuthor !== 'The Automations Guide';
const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  url: postUrl,
  mainEntityOfPage: postUrl,
  image: ogImage,
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
  ...(mentionedTools.length ? { about: mentionedTools, mentions: mentionedTools } : {}),
  author: {
    '@type': 'Person',
    name: displayAuthor,
    url: 'https://theautomationsguide.com/about/',
    ...(isNamedAuthor ? { jobTitle: 'Founder, Homegrown Growth Co' } : {}),
    sameAs: ['https://theautomationsguide.com/about/', 'https://homegrowngrowth.co'],
  },
  publisher: {
    '@type': 'Organization',
    name: 'The Automations Guide',
    url: 'https://theautomationsguide.com/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://theautomationsguide.com/hgc-logo.png',
    },
  },
};

const faqSchema =
  faqs && faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: { '@type': 'Answer', text: faq.answer },
        })),
      }
    : null;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <div class="container--wide">
    <article>
      <header class="post-header">
        {tags.length > 0 && (
          <div class="post-card-tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
        <h1>{title}</h1>
        <div class="post-meta">
          <span>By {displayAuthor} @ The Automations Guide</span>
          <span class="post-meta-sep">&middot;</span>
          <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
          <span class="post-meta-sep">&middot;</span>
          <span>{readTime} min read</span>
          {updatedDate && (
            <>
              <span class="post-meta-sep">&middot;</span>
              <span>Updated {formattedUpdatedDate}</span>
            </>
          )}
        </div>
      </header>

      <TableOfContents headings={headings} />

      <div class="prose">
        <slot />
      </div>

      {tags.length > 0 && (
        <div class="post-related-tags">
          <p class="post-related-tags-label">Filed under:</p>
          <div class="post-card-tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </div>
      )}

      <PostFaqs faqs={faqs} />

      <EmailSignup />

      <hr class="divider" />

      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
        <a href="/blog/" class="btn btn--ghost">&larr; Back to Blog</a>
        <p style="font-size:0.8rem;color:var(--text-faint)">
          Enjoying this? Share it with your team.
        </p>
      </div>

      <RelatedPosts posts={related} />

      <AuthorNote />

      <p class="post-disclosure">
        Some links are affiliate links. <a href="/disclosure/">Disclosure</a>.
      </p>
    </article>
  </div>
</BaseLayout>
