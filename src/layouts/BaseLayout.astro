---
import '../styles/global.css';
// Self-hosted brand fonts (Brand Kit v2.2) — replaces the render-blocking Google
// Fonts stylesheet. Only the weights actually used are imported. Metric-matched
// fallback @font-face faces (size-adjust/ascent-override) are auto-generated by
// the `fontaine` Vite plugin (see astro.config.mjs) so the swap causes ~0 CLS.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/800.css';
import '@fontsource/source-serif-4/600.css';
import Analytics from '../components/Analytics.astro';
import { navToolCategories, categoryAnchor } from '../data/tools';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Automation guides, tool reviews, and workflows for RevOps and GTM teams.',
  ogImage,
  ogType = 'website',
  noindex = false,
} = Astro.props;

// Every page gets a branded share card: posts pass their per-post /og/<slug>.png;
// everything else falls back to the generated default card (M-2 — no more bare
// text cards on link shares). new URL() leaves an already-absolute ogImage intact.
const ogImageURL = new URL(ogImage ?? '/og/default.png', Astro.site).toString();

const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'The Automations Guide';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const currentPath = Astro.url.pathname;

// --- JSON-LD: Organization (homepage only) ---
const isHomepage = currentPath === '/';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: 'https://theautomationsguide.com/',
  description:
    'Practical automation guides, tool reviews, and workflows for RevOps and go-to-market teams.',
  publisher: {
    '@type': 'Organization',
    name: 'Homegrown Growth Co',
    url: 'https://homegrowngrowth.co',
    logo: {
      '@type': 'ImageObject',
      url: 'https://theautomationsguide.com/hgc-logo.png',
    },
  },
  founder: {
    '@type': 'Person',
    name: 'Ian Chamberland',
    jobTitle: 'Founder, Homegrown Growth Co',
    url: 'https://www.linkedin.com/in/ianchamberland/',
    sameAs: [
      'https://www.linkedin.com/in/ianchamberland/',
      'https://homegrowngrowth.co',
    ],
  },
  sameAs: [
    'https://www.linkedin.com/company/the-automations-guide/',
    'https://x.com/the_automations',
    'https://homegrowngrowth.co',
  ],
};

// --- JSON-LD: WebSite (homepage only) ---
// Reinforces the brand entity ("The Automations Guide" as a named site, not just
// the generic phrase) and declares the on-site search so Google can show a
// sitelinks search box. Pairs with the Organization schema above.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  alternateName: 'Automations Guide',
  url: 'https://theautomationsguide.com/',
  publisher: {
    '@type': 'Organization',
    name: 'Homegrown Growth Co',
    url: 'https://homegrowngrowth.co',
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://theautomationsguide.com/search/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

// --- JSON-LD: BreadcrumbList (all pages) ---
const pathParts = currentPath.split('/').filter(Boolean);
const segmentLabels: Record<string, string> = {
  blog: 'Blog',
  teams: 'Teams',
  playbooks: 'Playbooks',
  tools: 'Tools',
  about: 'About',
};

const crumbs: { name: string; url: string }[] = [
  { name: 'Home', url: 'https://theautomationsguide.com/' },
];
if (pathParts[0] && segmentLabels[pathParts[0]]) {
  crumbs.push({
    name: segmentLabels[pathParts[0]],
    url: `https://theautomationsguide.com/${pathParts[0]}/`,
  });
}
if (pathParts[0] === 'blog' && pathParts[1]) {
  crumbs.push({ name: title, url: canonicalURL.toString() });
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: crumb.name,
    item: crumb.url,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content={siteName} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fdfcf8" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Brand fonts (Brand Kit v2.2) are self-hosted via @fontsource — imported in
         this layout's frontmatter, bundled into the stylesheet, no 3rd-party request. -->

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <!-- JSON-LD: Organization + WebSite (homepage only) -->
    {isHomepage && <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />}
    {isHomepage && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}

    <!-- JSON-LD: BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <!-- Per-page head injections (BlogPosting, FAQPage, etc.) -->
    <slot name="head" />

    <!-- Analytics (PostHog) -->
    <Analytics />

    <!-- Beehiiv attribution — tracks which page a subscribe came from -->
    <script type="text/javascript" async src="https://subscribe-forms.beehiiv.com/attribution.js"></script>
  </head>

  <body>
    <!-- Navigation -->
    <nav class="site-nav" role="navigation" aria-label="Main navigation">
      <div class="nav-inner">
        <a href="/" class="nav-logo">
          The <span class="logo-word">Automations<span class="logo-dot">.</span></span> Guide
        </a>
        <button class="nav-hamburger" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
          <svg class="nav-hamburger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line class="hb-line hb-line-top" x1="3" y1="6" x2="21" y2="6"></line>
            <line class="hb-line hb-line-mid" x1="3" y1="12" x2="21" y2="12"></line>
            <line class="hb-line hb-line-bot" x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <div class="nav-end" id="nav-menu" data-open="false">
          <ul class="nav-links">
            <li class="nav-dropdown" data-open="false">
              <button type="button" class="nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false" aria-controls="teams-menu" aria-current={currentPath.startsWith('/teams') ? 'page' : undefined}>
                Teams
                <svg class="nav-dropdown-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <ul class="nav-dropdown-menu" id="teams-menu">
                <li><a href="/teams/sales/" aria-current={currentPath === '/teams/sales/' ? 'page' : undefined}>For Sales</a></li>
                <li><a href="/teams/revops/" aria-current={currentPath === '/teams/revops/' ? 'page' : undefined}>For RevOps</a></li>
                <li><a href="/teams/marketing/" aria-current={currentPath === '/teams/marketing/' ? 'page' : undefined}>For Marketing</a></li>
                <li><a href="/teams/founders/" aria-current={currentPath === '/teams/founders/' ? 'page' : undefined}>For Founders</a></li>
              </ul>
            </li>
            <li><a href="/playbooks/" aria-current={currentPath.startsWith('/playbooks') ? 'page' : undefined}>Playbooks</a></li>
            <li><a href="/reviews/" aria-current={currentPath.startsWith('/reviews') ? 'page' : undefined}>Comparisons</a></li>
            <li class="nav-dropdown" data-open="false">
              <button type="button" class="nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false" aria-controls="tools-menu" aria-current={currentPath.startsWith('/tools') ? 'page' : undefined}>
                Tools
                <svg class="nav-dropdown-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <ul class="nav-dropdown-menu" id="tools-menu">
                <li><a href="/tools/" aria-current={currentPath === '/tools/' ? 'page' : undefined}>Browse all tools</a></li>
                {navToolCategories.map((cat) => (
                  <li><a href={`/tools/#${categoryAnchor(cat)}`}>{cat}</a></li>
                ))}
              </ul>
            </li>
            <li><a href="/blog/" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>Latest</a></li>
            <li><a href="/about/" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>About</a></li>
          </ul>
          <div class="nav-actions">
            <form class="nav-search" action="/search/" method="get" role="search" aria-label="Site search">
              <span class="nav-search-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="7"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </span>
              <input type="search" name="q" placeholder="Search..." aria-label="Search posts and tools" autocomplete="off" />
            </form>
            <a href="/#newsletter" class="btn btn--primary nav-cta">Newsletter</a>
            <a href="https://www.linkedin.com/company/the-automations-guide/" target="_blank" rel="noopener noreferrer" class="nav-icon-link" aria-label="The Automations Guide on LinkedIn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
            <a href="https://x.com/the_automations" target="_blank" rel="noopener noreferrer" class="nav-icon-link" aria-label="The Automations Guide on X">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </nav>
    <script is:inline>
      (function () {
        const btn = document.querySelector('.nav-hamburger');
        const menu = document.getElementById('nav-menu');
        if (!btn || !menu) return;
        function setOpen(open) {
          menu.dataset.open = open ? 'true' : 'false';
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        btn.addEventListener('click', () => setOpen(menu.dataset.open !== 'true'));
        // Close drawer when a link inside it is clicked (navigation moves on)
        menu.addEventListener('click', (e) => {
          if (e.target.closest('a')) setOpen(false);
        });
        // Close drawer on Escape
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.dataset.open === 'true') setOpen(false);
        });
        // If the viewport grows past mobile while drawer is open, close it
        const mq = window.matchMedia('(min-width: 768px)');
        const handleMq = () => { if (mq.matches) setOpen(false); };
        if (mq.addEventListener) mq.addEventListener('change', handleMq);
        else mq.addListener(handleMq);
      })();
    </script>
    <script is:inline>
      // Nav dropdowns (Teams, Tools): click to toggle (works on desktop + inside
      // the mobile drawer); desktop also opens on hover/focus via CSS. Opening one
      // closes the others. Closes on outside click and Escape.
      (function () {
        const dropdowns = Array.from(document.querySelectorAll('.nav-dropdown'));
        if (!dropdowns.length) return;
        const ctrls = dropdowns.map((dd) => {
          const toggle = dd.querySelector('.nav-dropdown-toggle');
          if (!toggle) return null;
          const setOpen = (open) => {
            dd.dataset.open = open ? 'true' : 'false';
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          };
          toggle.addEventListener('click', (e) => {
            e.preventDefault();
            const willOpen = dd.dataset.open !== 'true';
            ctrls.forEach((c) => { if (c && c.dd !== dd) c.setOpen(false); });
            setOpen(willOpen);
          });
          return { dd, setOpen };
        }).filter(Boolean);
        document.addEventListener('click', (e) => {
          ctrls.forEach((c) => { if (!c.dd.contains(e.target)) c.setOpen(false); });
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') ctrls.forEach((c) => c.setOpen(false));
        });
      })();
    </script>

    <!-- Page content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="nav-logo" style="display:inline-flex">
            The <span class="logo-word">Automations<span class="logo-dot">.</span></span> Guide
          </a>
          <p>Practical automation guides, tool reviews, and workflows for RevOps and go-to-market teams.</p>
        </div>
        <nav class="footer-links" aria-label="Site navigation">
          <p class="footer-col-label">Site</p>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/teams/">Teams</a></li>
            <li><a href="/playbooks/">Playbooks</a></li>
            <li><a href="/tools/">Tools</a></li>
            <li><a href="/blog/">Latest</a></li>
            <li><a href="/about/">About</a></li>
          </ul>
        </nav>
        <nav class="footer-links" aria-label="Legal navigation">
          <p class="footer-col-label">Legal</p>
          <ul>
            <li><a href="/disclosure/">Affiliate Disclosure</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
          </ul>
        </nav>
      </div>

      <div class="footer-bottom">
        <span>&copy; {new Date().getFullYear()} The Automations Guide</span>
        <span class="footer-bottom-sep">·</span>
        <a href="https://homegrowngrowth.co" target="_blank" rel="noopener noreferrer" class="footer-bottom-publisher" aria-label="Visit Homegrown Growth Co">
          Published by
          <img src="/hgc-logo.png" alt="" width="16" height="16" loading="lazy" />
          <span>Homegrown Growth Co</span>
        </a>
        <span class="footer-bottom-sep">·</span>
        <a href="/disclosure/">Affiliate disclosure</a>
      </div>
    </footer>
  </body>
</html>
