---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Automation guides, tool reviews, and workflows for RevOps and GTM teams.',
  ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'The Automations Guide';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const currentPath = Astro.url.pathname;

// --- JSON-LD: Organization (homepage only) ---
const isHomepage = currentPath === '/';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: 'https://theautomationsguide.com',
  description:
    'Practical automation guides, tool reviews, and workflows for RevOps and go-to-market teams.',
  publisher: {
    '@type': 'Organization',
    name: 'Homegrown Growth Co',
    url: 'https://homegrowngrowth.co',
    logo: {
      '@type': 'ImageObject',
      url: 'https://theautomationsguide.com/hgc-logo.png',
    },
  },
  founder: {
    '@type': 'Person',
    name: 'Ian Chamberland',
    jobTitle: 'Founder, Homegrown Growth Co',
    url: 'https://www.linkedin.com/in/ianchamberland/',
    sameAs: [
      'https://www.linkedin.com/in/ianchamberland/',
      'https://homegrowngrowth.co',
    ],
  },
  sameAs: [
    'https://www.linkedin.com/in/ianchamberland/',
    'https://homegrowngrowth.co',
  ],
};

// --- JSON-LD: BreadcrumbList (all pages) ---
const pathParts = currentPath.split('/').filter(Boolean);
const segmentLabels: Record<string, string> = {
  blog: 'Blog',
  tools: 'Tools',
  about: 'About',
};

const crumbs: { name: string; url: string }[] = [
  { name: 'Home', url: 'https://theautomationsguide.com/' },
];
if (pathParts[0] && segmentLabels[pathParts[0]]) {
  crumbs.push({
    name: segmentLabels[pathParts[0]],
    url: `https://theautomationsguide.com/${pathParts[0]}`,
  });
}
if (pathParts[0] === 'blog' && pathParts[1]) {
  crumbs.push({ name: title, url: canonicalURL.toString() });
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: crumb.name,
    item: crumb.url,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content={siteName} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d1117" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <!-- JSON-LD: Organization (homepage only) -->
    {isHomepage && <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />}

    <!-- JSON-LD: BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <!-- Per-page head injections (BlogPosting, FAQPage, etc.) -->
    <slot name="head" />

    <!-- Analytics (PostHog) -->
    <Analytics />

    <!-- Beehiiv attribution — tracks which page a subscribe came from -->
    <script type="text/javascript" async src="https://subscribe-forms.beehiiv.com/attribution.js"></script>
  </head>

  <body>
    <!-- Navigation -->
    <nav class="site-nav" role="navigation" aria-label="Main navigation">
      <div class="nav-inner">
        <a href="/" class="nav-logo">
          The <span>Automations</span> Guide
        </a>
        <ul class="nav-links">
          <li><a href="/blog" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>Blog</a></li>
          <li><a href="/tools" aria-current={currentPath === '/tools' ? 'page' : undefined}>Tools</a></li>
          <li><a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>About</a></li>
        </ul>
      </div>
    </nav>

    <!-- Page content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="nav-logo" style="display:inline-flex">
            The <span style="color:var(--accent);margin:0 0.25em">Automations</span> Guide
          </a>
          <p>Practical automation guides, tool reviews, and workflows for RevOps and go-to-market teams.</p>
        </div>
        <nav class="footer-links" aria-label="Site navigation">
          <p class="footer-col-label">Site</p>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/tools">Tools</a></li>
            <li><a href="/about">About</a></li>
          </ul>
        </nav>
        <nav class="footer-links" aria-label="Legal navigation">
          <p class="footer-col-label">Legal</p>
          <ul>
            <li><a href="/disclosure">Affiliate Disclosure</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
          </ul>
        </nav>
      </div>

      <div class="footer-bottom">
        <span>&copy; {new Date().getFullYear()} The Automations Guide</span>
        <span class="footer-bottom-sep">·</span>
        <a href="https://homegrowngrowth.co" target="_blank" rel="noopener noreferrer" class="footer-bottom-publisher" aria-label="Visit Homegrown Growth Co">
          Published by
          <img src="/hgc-logo.png" alt="" width="16" height="16" loading="lazy" />
          <span>Homegrown Growth Co</span>
        </a>
        <span class="footer-bottom-sep">·</span>
        <a href="/disclosure">Affiliate disclosure</a>
      </div>
    </footer>
  </body>
</html>
