# theautomationsguide - every environment variable the site, its scripts and its CI use.
# Added 2026-10-11 (op #1253): the Netlify and GitHub Actions variable sets were documented
# nowhere, so a rebuild on a new machine or a new Netlify site meant guessing.
# Values live in the password-manager vault (see SECRET-INVENTORY.md at the workspace root).

# --- local .env (scripts run from this checkout) ---------------------------------
ANTHROPIC_API_KEY=            # engine scripts (content generation, QA reply handler)
POSTHOG_PERSONAL_API_KEY=     # affiliate-click + conversion reports (scripts/)
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=

# --- Netlify site env (build-time, read via import.meta.env) ----------------------
# Set in Netlify UI > Site configuration > Environment variables. NODE_VERSION is in netlify.toml.
PUBLIC_GA4_ID=                # GA4 measurement id (public, safe to expose)
PUBLIC_CLARITY_ID=            # Microsoft Clarity project id (public)

# --- GitHub Actions secrets (repo Settings > Secrets and variables > Actions) ------
# secrets:
#   ANTHROPIC_API_KEY     content engine + QA workflows
#   GSC_TOKEN_JSON        Google Search Console OAuth token JSON (topic scoring, near-win reports)
#   N8N_API_KEY           HGC n8n Cloud public API key (retry / health workflows)
#   NOTION_TOKEN          Notion integration token (content calendar)
#   SLACK_WEBHOOK_URL     engine + watchdog notifications
#   GITHUB_TOKEN          provided by Actions automatically
# variables:
#   NOTION_DATABASE_ID    content calendar database
# Optional / local-only switches used by scripts: N8N_API_URL, GSC_SITE, GSC_TOKEN_FILE,
# NOTION_PARENT_PAGE_ID, QA_BASE_URL, CHROME_EXE, HEADED, DRY_RUN, DETAIL, RUNS, OUT.
