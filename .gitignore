# build output
dist/
.output/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.*
!.env.example

# macOS
.DS_Store

# editors
.vscode/
.idea/

# Claude Code (commit settings.json; ignore local overrides + history)
.claude/settings.local.json
.claude/file-history/

# QA artifacts (Playwright screenshots + Claude vision review output)
qa-screenshots/
qa-review.md

# Local screenshots (manual captures for debugging / PR review)
screenshots/
# ...but public/screenshots/ holds real, served site assets (tool product shots)
!public/screenshots/

# Topic backlog builder output (regenerable each run; see backlog/README.md)
backlog/backlog-batch.json
backlog/backlog-batch.md
# Tool LP builder output (regenerable each run; see backlog/build-tool-lp.mjs)
backlog/lp-batch.json
backlog/lp-batch.md

# GSC index-status audit artifacts (regenerable via gsc-index-status.py)
gsc-needs-indexing-*.csv
gsc-*.log

# PostHog setup artifact (insight/dashboard definitions + created ids; see analytics/README.md)
analytics/posthog-insights.json

# QA breadcrumb (unresolved tools list for the failure ping)
qa-unresolved-tools.txt
